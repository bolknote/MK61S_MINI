/* GNU ARMv6-M memset body, included inside basic asm.
 * Byte/halfword alignment, four STMIA stores per 64-byte iteration.
 * 0..7 bytes stay on a bounded byte path. No BootROM or runtime dependency.
 * Measured in SRAM on RP2040: research/rp2040-memset-2026-10-21.
 */
".syntax unified\n"
"cmp r2,#8\n"
"blo .Lfast_small\n"
"mov r12,r0\n"
"uxtb r1,r1\n"
"lsls r3,r1,#8\n"
"orrs r1,r3\n"
"lsls r3,r0,#31\n"
"bpl .Lfast_half\n"
"strb r1,[r0]\n"
"adds r0,#1\n"
"subs r2,#1\n"
".Lfast_half:\n"
"lsls r3,r0,#30\n"
"bpl .Lfast_word\n"
"strh r1,[r0]\n"
"adds r0,#2\n"
"subs r2,#2\n"
".Lfast_word:\n"
"rev r3,r1\n"
"orrs r1,r3\n"
"movs r3,r1\n"
"subs r2,#16\n"
"blo .Lfast_tail\n"
"push {r4,r5}\n"
"movs r4,r1\n"
"movs r5,r1\n"
"cmp r2,#48\n"
"blo .Lfast_16\n"
"subs r2,#48\n"
".Lfast_64:\n"
"stmia r0!,{r1,r3,r4,r5}\n"
"stmia r0!,{r1,r3,r4,r5}\n"
"stmia r0!,{r1,r3,r4,r5}\n"
"stmia r0!,{r1,r3,r4,r5}\n"
"subs r2,#64\n"
"bhs .Lfast_64\n"
"adds r2,#48\n"
"bcc .Lfast_pop\n"
".Lfast_16:\n"
"stmia r0!,{r1,r3,r4,r5}\n"
"subs r2,#16\n"
"bhs .Lfast_16\n"
".Lfast_pop:\n"
"pop {r4,r5}\n"
".Lfast_tail:\n"
"lsls r2,r2,#29\n"
"bcc .Lfast_four\n"
"stmia r0!,{r1,r3}\n"
".Lfast_four:\n"
"lsls r2,r2,#1\n"
"bcc .Lfast_two\n"
"stmia r0!,{r1}\n"
".Lfast_two:\n"
"beq .Lfast_done\n"
"lsls r2,r2,#1\n"
"bcc .Lfast_one\n"
"strh r1,[r0]\n"
"beq .Lfast_done\n"
"adds r0,#2\n"
".Lfast_one:\n"
"strb r1,[r0]\n"
".Lfast_done:\n"
"mov r0,r12\n"
"bx lr\n"
".Lfast_small:\n"
"cmp r2,#2\n"
"bhi .Lfast_bytes\n"
"cmp r2,#0\n"
"beq .Lfast_return\n"
"strb r1,[r0]\n"
"cmp r2,#1\n"
"beq .Lfast_return\n"
"strb r1,[r0,#1]\n"
".Lfast_return:\n"
"bx lr\n"
".Lfast_bytes:\n"
"adr r3,.Lfast_end\n"
"subs r3,r3,r2\n"
"subs r3,r3,r2\n"
"adds r3,#1\n"
"bx r3\n"
".balign 4\n"
"nop\n"
"strb r1,[r0,#6]\n"
"strb r1,[r0,#5]\n"
"strb r1,[r0,#4]\n"
"strb r1,[r0,#3]\n"
"strb r1,[r0,#2]\n"
"strb r1,[r0,#1]\n"
"strb r1,[r0]\n"
".Lfast_end:\n"
"bx lr\n"
