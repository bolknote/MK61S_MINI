# Two doubles suffice for a lossless undo record.
M=APMOVE;F=M MOD 128;T=INT(M/128) MOD 128;Q=INT(M/16384)
P=@(F);S=SGN(P);C=@(T);E=0
IF ABS(P)=1 IF T=EP IF C=0 C=@(T-10*S):E=1
@(APFRAME)=M+131072*(C+6)+2097152*E
@(APFRAME+1)=RIGHTS+16*EP+2048*HALF+524288*(SIDE=1)+1048576*LASTCAP+134217728*(CW+2*CB)+536870912*FULL
@(F)=0;@(T)=P;IF E=1 @(T-10*S)=0
IF Q>0 @(T)=Q*S
IF ABS(P)=6 G.:king
G.:rights
:king
IF S=1 WK=T
IF S=-1 BK=T
B=1;IF S=-1 B=4
FOR I=0 TO 1;A=B*2^I;IF INT(RIGHTS/A) MOD 2=1 RIGHTS=RIGHTS-A
NEXT I
IF ABS(T-F)#2 G.:rights
A=21;IF S=-1 A=91
IF T>F A=A+7
@(A)=0;@((F+T)/2)=4*S
IF S=1 CW=1
IF S=-1 CB=1
:rights
FOR I=0 TO 3
A=1*2^I;J=21
IF I=0 J=28
IF I=2 J=98
IF I=3 J=91
IF INT(RIGHTS/A) MOD 2=0 G.:next
IF (F=J) OR (T=J) RIGHTS=RIGHTS-A
:next
NEXT I
EP=0;IF ABS(P)=1 IF ABS(T-F)=20 EP=(T+F)/2
HALF=HALF+1;IF (ABS(P)=1) OR (C#0) HALF=0
LASTCAP=0;IF C#0 LASTCAP=T
IF S=-1 FULL=FULL+1
SIDE=-S
RET
