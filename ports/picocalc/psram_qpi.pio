; GPIO2..5=data, GPIO20/21=CE#/SCK. Six cycles per clock.
; ISR=nibbles-1; STATUS=TX level < packet words (1..8). Autopull is off.
; Wait for a WHOLE packet while CE# is high; every low-CE# pull is then
; satisfied independently of DMA stalls. Also supports the two-clock exit.
.program mk61_psram_qpi_write
.side_set 2
.wrap_target
write_ready:
    mov x, status side 1 [7]
    jmp x-- write_ready side 1
    mov x, isr side 1 [7]
    pull block side 1
write_nibble:
    pull ifempty block side 0
    out pins, 4 side 0
    nop side 2 [2]
    jmp x-- write_nibble side 0
.wrap

; EB/address words, each reading one aligned 16-byte block. RX has four
; words. Wait for ALL previous words to drain before asserting CE# again:
; stopped RX DMA can only stall this high-CE# wait. Six dummy clocks, four
; complete autopush words and the final data hold run autonomously.
.program mk61_psram_qpi_read
.side_set 2
.wrap_target
read_ready:
    pull block side 1 [7]
read_empty:
    mov x, status side 1
    jmp !x read_empty side 1
    set pindirs, 15 side 1
    set y, 7 side 1
read_header:
    out pins, 4 side 0
    nop side 2 [2]
    jmp y-- read_header side 0 [1]
    set pindirs, 0 side 0 [1]
    set y, 5 side 0 [1]
read_dummy:
    nop side 2 [2]
    jmp y-- read_dummy side 0 [2]
    set x, 31 side 0
read_nibble:
    nop side 2 [1]
    in pins, 4 side 2
    jmp x-- read_nibble side 0 [2]
    nop side 0 [7]
    nop side 1 [7]
.wrap
