/* ARMv6-M: bounded alignment repair, 64-byte aligned blocks and shifted
 * source words for unequal alignment. Short mismatched spans use a byte
 * loop: alignment setup costs more than it saves below 24 bytes. */
".syntax unified\n"
".macro mk61_memcpy_merge tag, k, unroll\n"
".Lmk61_memcpy_merge\\tag\\@:\n"
" movs r5,#0\n"
" .if \\k==3\n"
" ldrb r5,[r1,#2]\n"
" lsls r5,r5,#8\n"
" .endif\n"
" .if \\k>=2\n"
" ldrb r3,[r1,#1]\n"
" orrs r5,r3\n"
" lsls r5,r5,#8\n"
" .endif\n"
" ldrb r3,[r1]\n"
" orrs r5,r3\n"
" adds r1,#\\k\n"
" subs r2,#(4+\\k)\n"
" .if \\unroll\n"
" cmp r2,#12\n"
" blo .Lmk61_memcpy_mword\\@\n"
" subs r2,#12\n"
".Lmk61_memcpy_m16\\@:\n"
" .rept 4\n"
" ldmia r1!,{r3}\n"
" lsls r4,r3,#(\\k*8)\n"
" orrs r4,r5\n"
" stmia r0!,{r4}\n"
" lsrs r5,r3,#(32-\\k*8)\n"
" .endr\n"
" subs r2,#16\n"
" bhs .Lmk61_memcpy_m16\\@\n"
" adds r2,#12\n"
" bcc .Lmk61_memcpy_mend\\@\n"
" .endif\n"
".Lmk61_memcpy_mword\\@:\n"
" ldmia r1!,{r3}\n"
" lsls r4,r3,#(\\k*8)\n"
" orrs r4,r5\n"
" stmia r0!,{r4}\n"
" lsrs r5,r3,#(32-\\k*8)\n"
" subs r2,#4\n"
" bhs .Lmk61_memcpy_mword\\@\n"
".Lmk61_memcpy_mend\\@:\n"
" .rept \\k\n"
" strb r5,[r0]\n"
" adds r0,#1\n"
" lsrs r5,r5,#8\n"
" .endr\n"
" adds r2,#4\n"
" pop {r4,r5,r6}\n"
" b .Lmk61_memcpy_bytes\\tag\n"
".endm\n"
".macro mk61_memcpy_m0copy name, unroll\n"
" cmp r2,#8\n"
" bhs .Lmk61_memcpy_large\\@\n"
" cmp r2,#2\n"
" bhi .Lmk61_memcpy_computedSmall\\@\n"
" cmp r2,#0\n"
" beq .Lmk61_memcpy_tinyRet\\@\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
" cmp r2,#1\n"
" beq .Lmk61_memcpy_tinyRet\\@\n"
" ldrb r3,[r1,#1]\n"
" strb r3,[r0,#1]\n"
".Lmk61_memcpy_tinyRet\\@:\n"
" bx lr\n"
".Lmk61_memcpy_computedSmall\\@:\n"
" adr r3,.Lmk61_memcpy_smallEnd\\@\n"
" lsls r2,r2,#2\n"
" subs r3,r3,r2\n"
" adds r3,#1\n"
" bx r3\n"
" .balign 4\n"
" ldrb r3,[r1,#6]\n"
" strb r3,[r0,#6]\n"
" ldrb r3,[r1,#5]\n"
" strb r3,[r0,#5]\n"
" ldrb r3,[r1,#4]\n"
" strb r3,[r0,#4]\n"
" ldrb r3,[r1,#3]\n"
" strb r3,[r0,#3]\n"
" ldrb r3,[r1,#2]\n"
" strb r3,[r0,#2]\n"
" ldrb r3,[r1,#1]\n"
" strb r3,[r0,#1]\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
".Lmk61_memcpy_smallEnd\\@:\n"
" bx lr\n"
".Lmk61_memcpy_large\\@:\n"
" mov r12,r0\n"
" movs r3,r0\n"
" eors r3,r1\n"
" lsls r3,r3,#30\n"
" bne .Lmk61_memcpy_mismatch\\@\n"
" push {r4,r5,r6}\n"
" lsls r3,r0,#31\n"
" bpl .Lmk61_memcpy_alignHalf\\@\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
" adds r0,#1\n"
" adds r1,#1\n"
" subs r2,#1\n"
".Lmk61_memcpy_alignHalf\\@:\n"
" lsls r3,r0,#30\n"
" bpl .Lmk61_memcpy_words\\@\n"
" ldrh r3,[r1]\n"
" strh r3,[r0]\n"
" adds r0,#2\n"
" adds r1,#2\n"
" subs r2,#2\n"
" b .Lmk61_memcpy_words\\@\n"
".Lmk61_memcpy_mismatch\\@:\n"
" cmp r2,#24\n"
" blo .Lmk61_memcpy_reverse\\@\n"
" push {r4,r5,r6}\n"
" movs r4,#3\n"
".Lmk61_memcpy_align\\@:\n"
" tst r0,r4\n"
" beq .Lmk61_memcpy_aligned\\@\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
" adds r0,#1\n"
" adds r1,#1\n"
" subs r2,#1\n"
" b .Lmk61_memcpy_align\\@\n"
".Lmk61_memcpy_aligned\\@:\n"
" movs r3,r1\n"
" ands r3,r4\n"
" cmp r3,#1\n"
" beq .Lmk61_memcpy_case3\\@\n"
" cmp r3,#2\n"
" bne .Lmk61_memcpy_not2\\@\n"
" b .Lmk61_memcpy_case2\\@\n"
".Lmk61_memcpy_not2\\@:\n"
" b .Lmk61_memcpy_case1\\@\n"
".Lmk61_memcpy_reverse\\@:\n"
" subs r2,#1\n"
" ldrb r3,[r1,r2]\n"
" strb r3,[r0,r2]\n"
" bne .Lmk61_memcpy_reverse\\@\n"
" bx lr\n"
".Lmk61_memcpy_words\\@:\n"
" subs r2,#16\n"
" blo .Lmk61_memcpy_tail\\@\n"
" .if \\unroll\n"
" cmp r2,#48\n"
" blo .Lmk61_memcpy_16\\@\n"
" subs r2,#48\n"
".Lmk61_memcpy_64\\@:\n"
" .rept 4\n"
" ldmia r1!,{r3,r4,r5,r6}\n"
" stmia r0!,{r3,r4,r5,r6}\n"
" .endr\n"
" subs r2,#64\n"
" bhs .Lmk61_memcpy_64\\@\n"
" adds r2,#48\n"
" bcc .Lmk61_memcpy_tail\\@\n"
" .endif\n"
".Lmk61_memcpy_16\\@:\n"
" ldmia r1!,{r3,r4,r5,r6}\n"
" stmia r0!,{r3,r4,r5,r6}\n"
" subs r2,#16\n"
" bhs .Lmk61_memcpy_16\\@\n"
".Lmk61_memcpy_tail\\@:\n"
" lsls r2,r2,#29\n"
" bcc .Lmk61_memcpy_four\\@\n"
" ldmia r1!,{r3,r4}\n"
" stmia r0!,{r3,r4}\n"
".Lmk61_memcpy_four\\@:\n"
" lsls r2,r2,#1\n"
" bcc .Lmk61_memcpy_half\\@\n"
" ldmia r1!,{r3}\n"
" stmia r0!,{r3}\n"
".Lmk61_memcpy_half\\@:\n"
" beq .Lmk61_memcpy_done\\@\n"
" lsls r2,r2,#1\n"
" bcc .Lmk61_memcpy_one\\@\n"
" ldrh r3,[r1]\n"
" strh r3,[r0]\n"
" beq .Lmk61_memcpy_done\\@\n"
" adds r0,#2\n"
" adds r1,#2\n"
".Lmk61_memcpy_one\\@:\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
".Lmk61_memcpy_done\\@:\n"
" pop {r4,r5,r6}\n"
" mov r0,r12\n"
" bx lr\n"
".Lmk61_memcpy_popbytes\\@:\n"
" pop {r4,r5,r6}\n"
".Lmk61_memcpy_bytes\\name:\n"
" cmp r2,#0\n"
" beq .Lmk61_memcpy_return\\@\n"
".Lmk61_memcpy_byte\\@:\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
" adds r0,#1\n"
" adds r1,#1\n"
" subs r2,#1\n"
" bne .Lmk61_memcpy_byte\\@\n"
".Lmk61_memcpy_return\\@:\n"
" mov r0,r12\n"
" bx lr\n"
".Lmk61_memcpy_case3\\@:\n"
" mk61_memcpy_merge \\name,3,\\unroll\n"
".Lmk61_memcpy_case2\\@:\n"
" mk61_memcpy_merge \\name,2,\\unroll\n"
".Lmk61_memcpy_case1\\@:\n"
" mk61_memcpy_merge \\name,1,\\unroll\n"
".endm\n"
"mk61_memcpy_m0copy mk61_memcpy,1\n"
".purgem mk61_memcpy_m0copy\n"
".purgem mk61_memcpy_merge\n"
".syntax divided\n"
