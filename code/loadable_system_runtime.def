/* Ordered ARM EABI / ISO C services. Append only; part of System API v1. */
/* Consumers that only need slot names can keep the single-argument macro.
 * The resident uses real ISO C signatures so LTO sees the same declarations
 * as the global functions, even though the exported table erases their types. */
#ifndef MK61_RUNTIME_ISO_C
#define MK61_RUNTIME_ISO_C(name, result, ...) MK61_RUNTIME(name)
#define MK61_RUNTIME_ISO_C_DEFAULT
#endif
MK61_RUNTIME(__aeabi_dadd)
MK61_RUNTIME(__aeabi_dsub)
MK61_RUNTIME(__aeabi_dmul)
MK61_RUNTIME(__aeabi_ddiv)
MK61_RUNTIME(__aeabi_dcmpeq)
MK61_RUNTIME(__aeabi_dcmplt)
MK61_RUNTIME(__aeabi_dcmple)
MK61_RUNTIME(__aeabi_dcmpge)
MK61_RUNTIME(__aeabi_dcmpgt)
MK61_RUNTIME(__aeabi_d2iz)
MK61_RUNTIME(__aeabi_d2uiz)
MK61_RUNTIME(__aeabi_i2d)
MK61_RUNTIME(__aeabi_ui2d)
MK61_RUNTIME(__aeabi_d2lz)
MK61_RUNTIME(__aeabi_d2ulz)
MK61_RUNTIME(__aeabi_l2d)
MK61_RUNTIME(__aeabi_ul2d)
MK61_RUNTIME(__aeabi_uldivmod)
MK61_RUNTIME_ISO_C(strchr, char*, const char*, int)
MK61_RUNTIME_ISO_C(strncmp, int, const char*, const char*, size_t)
MK61_RUNTIME_ISO_C(strlen, size_t, const char*)
MK61_RUNTIME_ISO_C(strncat, char*, char*, const char*, size_t)
MK61_RUNTIME_ISO_C(memcpy, void*, void*, const void*, size_t)
MK61_RUNTIME_ISO_C(memset, void*, void*, int, size_t)
MK61_RUNTIME_ISO_C(memmove, void*, void*, const void*, size_t)
MK61_RUNTIME_ISO_C(memcmp, int, const void*, const void*, size_t)
#ifdef MK61_RUNTIME_ISO_C_DEFAULT
#undef MK61_RUNTIME_ISO_C_DEFAULT
#undef MK61_RUNTIME_ISO_C
#endif
