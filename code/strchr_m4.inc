/* Source-exact prefix16 or compact byte1; body hashes are checked by ARM qualification. */
".syntax unified\n"
#if defined(MK61_STRCHR_M4_COMPACT) && MK61_STRCHR_M4_COMPACT
"uxtb r1,r1\n"
".Lmk61_strchr_byte:\n"
"ldrb r2,[r0]\n"
"cmp r2,r1\n"
"beq .Lmk61_strchr_return\n"
"adds r0,#1\n"
"cmp r2,#0\n"
"bne .Lmk61_strchr_byte\n"
"movs r0,#0\n"
".Lmk61_strchr_return:\n"
"bx lr\n"
#else
"uxtb r1,r1\n"
"ldrb r2,[r0]\n"
"cmp r2,r1\n"
"beq .Lmk61_strchr_return\n"
"cmp r2,#0\n"
"beq .Lmk61_strchr_zero\n"
"ldrb r2,[r0,#1]\n"
"cmp r2,r1\n"
"beq .Lmk61_strchr_one\n"
"cmp r2,#0\n"
"beq .Lmk61_strchr_zero\n"
"ldrb r2,[r0,#2]\n"
"cmp r2,r1\n"
"beq .Lmk61_strchr_two\n"
"cmp r2,#0\n"
"beq .Lmk61_strchr_zero\n"
"ldrb r2,[r0,#3]\n"
"cmp r2,r1\n"
"beq .Lmk61_strchr_three\n"
"cmp r2,#0\n"
"beq .Lmk61_strchr_zero\n"
"adds r0,#4\n"
"b .Lmk61_strchr_next\n"
".Lmk61_strchr_three:\n"
"adds r0,#1\n"
".Lmk61_strchr_two:\n"
"adds r0,#1\n"
".Lmk61_strchr_one:\n"
"adds r0,#1\n"
".Lmk61_strchr_return:\n"
"bx lr\n"
".Lmk61_strchr_zero:\n"
"movs r0,#0\n"
"bx lr\n"
".Lmk61_strchr_next:\n"
".rept 3\n"
"ldrb r2,[r0]\n"
"cmp r2,r1\n"
"beq .Lmk61_strchr_return\n"
"cmp r2,#0\n"
"beq .Lmk61_strchr_zero\n"
"ldrb r2,[r0,#1]\n"
"cmp r2,r1\n"
"beq .Lmk61_strchr_one\n"
"cmp r2,#0\n"
"beq .Lmk61_strchr_zero\n"
"ldrb r2,[r0,#2]\n"
"cmp r2,r1\n"
"beq .Lmk61_strchr_two\n"
"cmp r2,#0\n"
"beq .Lmk61_strchr_zero\n"
"ldrb r2,[r0,#3]\n"
"cmp r2,r1\n"
"beq .Lmk61_strchr_three\n"
"cmp r2,#0\n"
"beq .Lmk61_strchr_zero\n"
"adds r0,#4\n"
".endr\n"
".Lmk61_strchr_prefix:\n"
"ldrb r2,[r0]\n"
"cmp r2,r1\n"
"beq .Lmk61_strchr_return\n"
"cmp r2,#0\n"
"beq .Lmk61_strchr_zero\n"
"lsls r3,r0,#30\n"
"beq .Lmk61_strchr_aligned\n"
"adds r0,#1\n"
"b .Lmk61_strchr_prefix\n"
".Lmk61_strchr_aligned:\n"
"push {r4,r5}\n"
"ldr r4,.Lmk61_strchr_ones\n"
"mul r1,r1,r4\n"
".Lmk61_strchr_loop:\n"
".rept 2\n"
"ldr r3,[r0]\n"
"uqsub8 r2,r4,r3\n"
"eor r12,r3,r1\n"
"uqsub8 r12,r4,r12\n"
"orrs r2,r2,r12\n"
"bne .Lmk61_strchr_found\n"
"adds r0,#4\n"
".endr\n"
"b .Lmk61_strchr_loop\n"
".Lmk61_strchr_found:\n"
"rbit r2,r2\n"
"clz r2,r2\n"
"add r0,r0,r2,lsr#3\n"
"uxtb r1,r1\n"
"ldrb r2,[r0]\n"
"cmp r2,r1\n"
"beq .Lmk61_strchr_saved\n"
"movs r0,#0\n"
".Lmk61_strchr_saved:\n"
"pop {r4,r5}\n"
"bx lr\n"
".balign 4\n"
".Lmk61_strchr_ones:\n"
".word 0x01010101\n"
#endif
