/* Aligned containing-word search; no prefix read. */
".syntax unified\n"
"mov r1,r0\n"
"1: ldrb r2,[r0]\n"
"cmp r2,#0\n"
"beq 9f\n"
"lsls r3,r0,#30\n"
"beq 2f\n"
"adds r0,#1\n"
"b 1b\n"
"2: push {r4,r5}\n"
"ldr r4,10f\n"
"lsls r5,r4,#7\n"
"3:\n"
".rept 1\n"
#if MK61_M0_LIBC_CURRENT == 16
"ldmia r0!,{r2}\n"
"subs r3,r2,r4\n"
"bics r3,r2\n"
"tst r3,r5\n"
"bne 4f\n"
#endif
"ldmia r0!,{r2}\n"
"subs r3,r2,r4\n"
"bics r3,r2\n"
"tst r3,r5\n"
"bne 4f\n"
".endr\n"
"b 3b\n"
"4: subs r0,#4\n"
"5: uxtb r3,r2\n"
"cmp r3,#0\n"
"beq 6f\n"
"lsrs r2,#8\n"
"adds r0,#1\n"
"b 5b\n"
"6: subs r0,r0,r1\n"
"pop {r4,r5}\n"
"bx lr\n"
"9: subs r0,r0,r1\n"
"bx lr\n"
".p2align 2\n"
"10: .word 0x01010101\n"
