# The SDK is a pinned header-only snapshot committed with the project.
if(NOT DEFINED MK61_SDK_ROOT OR MK61_SDK_ROOT STREQUAL "")
  set(MK61_SDK_ROOT "${MK61_PROJECT_ROOT}/third_party/stm32f4")
endif()
file(REAL_PATH "${MK61_SDK_ROOT}" MK61_SDK_ROOT)
set(_mk61_sdk_manifest "${MK61_SDK_ROOT}/manifest.json")
if(NOT EXISTS "${_mk61_sdk_manifest}")
  message(FATAL_ERROR "Native SDK manifest is missing: ${_mk61_sdk_manifest}")
endif()
file(READ "${_mk61_sdk_manifest}" _mk61_sdk_json)
string(JSON _mk61_sdk_schema GET "${_mk61_sdk_json}" schema)
if(NOT _mk61_sdk_schema EQUAL 1)
  message(FATAL_ERROR "Unsupported native SDK manifest schema")
endif()
string(JSON _mk61_sdk_files LENGTH "${_mk61_sdk_json}" files)
if(_mk61_sdk_files LESS 10)
  message(FATAL_ERROR "Native SDK header set is incomplete")
endif()
math(EXPR _mk61_sdk_last "${_mk61_sdk_files} - 1")
foreach(_mk61_sdk_index RANGE 0 ${_mk61_sdk_last})
  string(JSON _mk61_sdk_name MEMBER "${_mk61_sdk_json}" files ${_mk61_sdk_index})
  if(_mk61_sdk_name MATCHES "(^/|(^|/)\\.\\.(/|$)|\\\\)")
    message(FATAL_ERROR "Invalid native SDK file path: ${_mk61_sdk_name}")
  endif()
  set(_mk61_sdk_file "${MK61_SDK_ROOT}/${_mk61_sdk_name}")
  if(NOT EXISTS "${_mk61_sdk_file}")
    message(FATAL_ERROR "Native SDK file is missing: ${_mk61_sdk_name}")
  endif()
  string(JSON _mk61_sdk_expected GET "${_mk61_sdk_json}" files "${_mk61_sdk_name}")
  file(SHA256 "${_mk61_sdk_file}" _mk61_sdk_actual)
  if(NOT _mk61_sdk_actual STREQUAL _mk61_sdk_expected)
    message(FATAL_ERROR "Native SDK checksum mismatch: ${_mk61_sdk_name}")
  endif()
endforeach()
foreach(_mk61_sdk_component cmsis device hal usb usb-interface)
  if(NOT IS_DIRECTORY "${MK61_SDK_ROOT}/${_mk61_sdk_component}/include")
    message(FATAL_ERROR "Native SDK component is missing: ${_mk61_sdk_component}")
  endif()
endforeach()
message(STATUS "Verified pinned native SDK: ${MK61_SDK_ROOT}")
