    {
      "id": "spectrum-cosmic-payback",
      "title": "Spectrum: Cosmic Payback",
      "description": "Download the pinned freeware game package",
      "default": false,
      "runner": "spectrum_package",
      "package": "cosmic-payback"
    },
    {
      "id": "spectrum-ulaplus",
      "title": "Spectrum: ULAplus collection",
      "description": "Download the large licensed ULAplus game collection",
      "default": false,
      "runner": "spectrum_package",
      "package": "ulaplus"
    },
    {
      "id": "build-spectrum-app",
      "title": "Build SPECTRUM.APP",
      "description": "Build our PicoCalc emulator and fetch its pinned device assets",
      "default": false,
      "runner": "python",
      "windows_supported": false,
      "arguments": [
        "tools/apps/spectrum/build_spectrum_app.py",
        "--fetch-devices",
        "--output-dir",
        "{output}/sd/apps/SPECTRUM"
      ],
      "with_games_when_selected": [
        "spectrum-ianna",
        "spectrum-cosmic-payback",
        "spectrum-ulaplus"
      ]
    },
    {
      "id": "build-urq-app",
      "title": "Build URQ.APP",
      "description": "Build our PicoCalc text-game player and copy its library",
      "default": false,
      "runner": "python",
      "windows_supported": false,
      "arguments": [
        "tools/apps/urq/build_urq_app.py",
        "--target",
        "picocalc-pico-h",
        "--output-dir",
        "{output}/sd/apps/URQ",
        "--library-output",
        "{output}/sd/urq",
        "--licenses-output",
        "{output}/sd/apps/URQ/licenses"
