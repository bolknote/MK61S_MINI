U=@(APFRAME);V=@(APFRAME+1)
M=U MOD 131072;F=M MOD 128;T=INT(M/128) MOD 128;Q=INT(M/16384)
C=INT(U/131072) MOD 16-6;E=INT(U/2097152) MOD 2
P=@(T);S=SGN(P)
IF Q>0 P=S
@(F)=P;@(T)=C
IF E=1 @(T)=0:@(T-10*S)=C
IF ABS(P)#6 G.:state
IF S=1 WK=F
IF S=-1 BK=F
IF ABS(T-F)#2 G.:state
A=21;IF S=-1 A=91
IF T>F A=A+7
@(A)=4*S;@((F+T)/2)=0
:state
RIGHTS=V MOD 16;EP=INT(V/16) MOD 128;HALF=INT(V/2048) MOD 256
SIDE=2*(INT(V/524288) MOD 2)-1;LASTCAP=INT(V/1048576) MOD 128
CW=INT(V/134217728) MOD 2;CB=INT(V/268435456) MOD 2;FULL=INT(V/536870912)
RET
