IF RP_BRANCH=2 RP_HCUR=RP_HCUR-1
A=INT(@(HIST+INT(RP_HCUR/4))/4096^(RP_HCUR MOD 4)) MOD 4096
F=21+A MOD 8+10*INT((A MOD 64)/8)
T=21+INT(A/64) MOD 8+10*INT(A/512)
IF RP_BRANCH=2 B=F:F=T:T=B
P=@(F);@(F)=0;@(T)=P
IF P=6 WK=T
IF P=-6 BK=T
SIDE=-SIDE;EP=0
IF RP_BRANCH=2 IF RP_HCUR=0 EP=HEP
IF RP_BRANCH=3 RP_HCUR=RP_HCUR+1
RET
