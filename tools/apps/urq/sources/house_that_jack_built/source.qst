:ru_v0__check
correct=0
if рис = "рис" then correct = correct + 1
if крыс = "крыс" then correct = correct + 1
if кот = "кот" then correct = correct + 1
if пёс = "пёс" or пёс = "пес" then correct = correct + 1
if коров = "коров" then correct = correct + 1
if пса = "пса" then correct = correct + 1
if девиц = "девиц" or девиц = "молочниц" then correct = correct + 1
if пастух = "пастух" then correct = correct + 1
if петуха = "петуха" then correct = correct + 1
if correct = words then pln Всё верно. Это победа! & quit
if correct = 0 then pln У вас 0 правильных вариантов. Это провал!
if correct = 1 then percentage = 11
if correct = 2 then percentage = 22
if correct = 3 then percentage = 33
if correct = 4 then percentage = 44
if correct = 5 then percentage = 56
if correct = 6 then percentage = 67
if correct = 7 then percentage = 78
if correct = 8 then percentage = 89
if correct > 0 then pln У вас #percentage$% правильных вариантов. Надо ещё поработать!
current_label=label + number
btn #current_label$, Продолжить
end

