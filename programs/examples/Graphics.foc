1.10 IF(GW) 9.10,9.10
1.20 IF(GH-32) 3.10
1.22 SET D=1
1.24 IF(GW-320) 1.30
1.26 SET D=2
1.30 CLS; BOX 0,0,GW-1,GH-1
1.40 PRINT AT 4,2,"FOCAL GRAPHICS"
1.50 LINE 1,12*D,GW-2,12*D
1.60 LINE 8,GH-13*D,GW/3-8,20*D
1.70 BOX GW/3+4,20*D,2*GW/3-4,GH-13*D,1,1
1.80 BOX GW/3+8,24*D,2*GW/3-8,GH-17*D,2,1
1.90 CIRCLE 5*GW/6,(GH+16*D)/2,(GH-26*D)/3
1.92 PRINT AT GW/6-12*D,GH-10*D,"LINE"
1.94 PRINT AT GW/2-9*D,GH-10*D,"BOX"
1.96 PRINT AT 5*GW/6-18*D,GH-10*D,"CIRCLE"
1.98 SHOW; ASK
2.10 CLS; BOX 0,0,GW-1,GH-1
2.20 LINE 1,GH*5/6,GW-2,GH*5/6
2.30 LINE (GW-1)/2,12*D,(GW-1)/2,GH-2
2.40 GRAPH X*X,-2,2,-1,5
2.50 PRINT AT 4,2,"Y = X^2"
2.60 PRINT AT 4,GH-10*D,GW,"x",GH
2.70 SHOW; ASK; EXIT
3.10 CLS; BOX 0,0,GW-1,GH-1
3.20 LINE 1,GH-2,GW/3-1,1
3.30 CIRCLE 5*GW/6,GH/2,GH/3
3.40 PRINT AT GW/3,1,"FOCAL"
3.50 SHOW; ASK; EXIT
9.10 EXIT
