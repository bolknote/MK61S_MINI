10 IF GW=0 END
20 IF GH<32 GOTO 200
22 LET D=1
24 IF GW>=320 LET D=2
30 CLS:BOX 0,0,GW-1,GH-1
40 PRINT AT 4,2;"BASIC GRAPHICS"
50 LINE 1,12*D,GW-2,12*D
60 LINE 8,GH-13*D,GW/3-8,20*D
70 BOX GW/3+4,20*D,2*GW/3-4,GH-13*D,1,1
80 BOX GW/3+8,24*D,2*GW/3-8,GH-17*D,2,1
90 CIRCLE 5*GW/6,(GH+16*D)/2,(GH-26*D)/3
100 PRINT AT GW/6-12*D,GH-10*D;"LINE"
104 PRINT AT GW/2-9*D,GH-10*D;"BOX"
108 PRINT AT 5*GW/6-18*D,GH-10*D;"CIRCLE"
110 SHOW:PAUSE
120 CLS:BOX 0,0,GW-1,GH-1
130 LINE 1,GH*5/6,GW-2,GH*5/6
140 LINE (GW-1)/2,12*D,(GW-1)/2,GH-2
150 GRAPH X*X,-2,2,-1,5
160 PRINT AT 4,2;"Y = X^2"
170 PRINT AT 4,GH-10*D;GW;"x";GH
180 SHOW:PAUSE
190 END
200 CLS:BOX 0,0,GW-1,GH-1
210 LINE 1,GH-2,GW/3-1,1
220 CIRCLE 5*GW/6,GH/2,GH/3
230 PRINT AT GW/3,1;"BASIC"
240 SHOW:PAUSE
250 END
