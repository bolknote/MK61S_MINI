10 IF GW=0 END
20 IF GH<32 GOTO 200
30 CLS:BOX 0,0,GW-1,GH-1
40 PRINT AT 4,2;"BASIC GRAPHICS"
50 LINE 1,12,GW-2,12
60 LINE 8,GH-13,GW/3-8,20
70 BOX GW/3+4,20,2*GW/3-4,GH-13,1,1
80 BOX GW/3+8,24,2*GW/3-8,GH-17,2,1
90 CIRCLE 5*GW/6,(GH+16)/2,(GH-26)/3
100 PRINT AT 4,GH-10;"LINE       BOX      CIRCLE"
110 SHOW:PAUSE
120 CLS:BOX 0,0,GW-1,GH-1
130 LINE 1,GH*5/6,GW-2,GH*5/6
140 LINE (GW-1)/2,12,(GW-1)/2,GH-2
150 GRAPH X*X,-2,2,-1,5
160 PRINT AT 4,2;"Y = X^2"
170 PRINT AT 4,GH-10;GW;"x";GH
180 SHOW:PAUSE
190 END
200 CLS:BOX 0,0,GW-1,GH-1
210 LINE 1,GH-2,GW/3-1,1
220 CIRCLE 2*GW/3,GH/2,GH/3
230 PRINT AT GW/3,1;"BASIC"
240 SHOW:PAUSE
250 END
