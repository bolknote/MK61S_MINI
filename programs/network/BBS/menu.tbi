10 .RE=99
20 PRINT TO C,LF$+"L list / R read / P post / ? help / Q quit" TIMEOUT 5000 STATUS S
30 IF S<>0 END
40 PRINT TO C,"> "; TIMEOUT 5000 STATUS S
50 IF S<>0 END
60 LINE INPUT FROM C,A$ TIMEOUT 60000 STATUS S
70 IF S=5 GOTO 20
80 IF S=9 GOTO 20
90 IF S<>0 END
100 .RE=1
110 IF A$="L" .RE=2
120 IF A$="l" .RE=2
130 IF A$="R" .RE=3
140 IF A$="r" .RE=3
150 IF A$="P" .RE=4
160 IF A$="p" .RE=4
170 IF A$="?" .RE=5
180 IF A$="Q" .RE=99
190 IF A$="q" .RE=99
200 END
