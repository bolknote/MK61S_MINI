10 .RE=99:F=0
20 PRINT TO C,"Subject (1-64 characters, empty cancels): "; TIMEOUT 5000 STATUS S
30 IF S<>0 END
40 LINE INPUT FROM C,T$ TIMEOUT 60000 STATUS S
50 IF S=5 GOTO 20
60 IF S=9 GOTO 20
70 IF S<>0 END
80 IF LEN(T$)=0 GOTO 700
90 PRINT TO C,"Four lines, up to 128 characters each. Empty lines are allowed." TIMEOUT 5000 STATUS S
100 IF S<>0 END
110 LINE INPUT FROM C,D$ TIMEOUT 60000 STATUS S
120 IF S=5 GOTO 110
130 IF S=9 GOTO 110
140 IF S<>0 END
150 LINE INPUT FROM C,E$ TIMEOUT 60000 STATUS S
160 IF S=5 GOTO 150
170 IF S=9 GOTO 150
180 IF S<>0 END
190 LINE INPUT FROM C,G$ TIMEOUT 60000 STATUS S
200 IF S=5 GOTO 190
210 IF S=9 GOTO 190
220 IF S<>0 END
230 LINE INPUT FROM C,H$ TIMEOUT 60000 STATUS S
240 IF S=5 GOTO 230
250 IF S=9 GOTO 230
260 IF S<>0 END
270 PRINT TO C,"Save? Y/N: "; TIMEOUT 5000 STATUS S
280 IF S<>0 END
290 LINE INPUT FROM C,A$ TIMEOUT 60000 STATUS S
300 IF S<>0 END
310 IF A$="Y" GOTO 350
320 IF A$="y" GOTO 350
330 GOTO 700
350 J=1:K=0
360 DIR "Messages",K INTO N$ STATUS S
370 IF S=1 GOTO 420
380 IF S<>0 END
390 J=J+1:GOTO 360
420 IF J>999 GOTO 650
430 P$="Messages/m"+STR$(J)+".txt"
440 OPEN P$ FOR INPUT AS F STATUS S
450 IF S=4 GOTO 510
460 IF S<>0 GOTO 650
470 CLOSE F TIMEOUT 1000 STATUS S
480 F=0:IF S<>0 END
490 J=J+1:GOTO 420
510 WRITE FILE P$,"From: "+U$+LF$+"Subject: "+T$+LF$+LF$+D$+LF$+E$+LF$+G$+LF$+H$+LF$ STATUS S
520 IF S<>0 GOTO 650
530 PRINT TO C,"Saved: m"+STR$(J)+".txt" TIMEOUT 5000 STATUS S
540 IF S<>0 END
550 GOTO 700
650 PRINT TO C,"Save failed. No automatic retry; list messages before posting again." TIMEOUT 5000 STATUS S
660 IF S<>0 END
700 .RE=1:END
