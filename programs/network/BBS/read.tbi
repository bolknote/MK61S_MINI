10 .RE=99:K=0:F=0
20 PRINT TO C,"Filename from L (empty cancels): "; TIMEOUT 5000 STATUS S
30 IF S<>0 END
40 LINE INPUT FROM C,A$ TIMEOUT 60000 STATUS S
50 IF S=5 GOTO 20
60 IF S=9 GOTO 20
70 IF S<>0 END
80 IF LEN(A$)=0 GOTO 250
90 DIR "Messages",K INTO N$ STATUS S
100 IF S=1 GOTO 280
110 IF S<>0 END
120 IF N$<>A$ GOTO 90
130 P$="Messages/"+N$
140 OPEN P$ FOR INPUT AS F STATUS S
150 IF S<>0 GOTO 280
160 READ FROM F,B$ STATUS S
170 IF S=1 GOTO 230
180 IF S<>0 GOTO 300
190 PRINT TO C,B$; TIMEOUT 5000 STATUS S
200 IF S<>0 GOTO 300
210 GOTO 160
230 CLOSE F TIMEOUT 1000 STATUS S
240 F=0:IF S<>0 END
250 .RE=1:END
280 PRINT TO C,"Message unavailable." TIMEOUT 5000 STATUS S
290 IF S=0 GOTO 250
295 END
300 CLOSE F TIMEOUT 1000 STATUS S
310 F=0:END
