10 .RE=99:K=0:J=0
20 PRINT TO C,LF$+"Messages (use the filename to read):" TIMEOUT 5000 STATUS S
30 IF S<>0 END
40 DIR "Messages",K INTO N$ STATUS S
50 IF S=1 GOTO 110
60 IF S<>0 END
70 PRINT TO C,N$ TIMEOUT 5000 STATUS S
80 IF S<>0 END
90 J=J+1
100 GOTO 40
110 PRINT TO C,"Total: "+STR$(J) TIMEOUT 5000 STATUS S
120 IF S=0 .RE=1
130 END
