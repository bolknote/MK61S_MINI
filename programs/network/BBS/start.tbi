10 DIM U$(32),T$(64),P$(96),N$(48),A$(80),B$(160),D$(128),E$(128),G$(128),H$(128)
20 C=0:F=0:.RE=0
30 OPEN "USB:TEXT" AS C TIMEOUT 60000 STATUS S
40 IF S<>0 END
50 .RE=99
60 PRINT TO C,"MK61 BBS / BASIC + M61"+LF$+"One visitor. Messages live in calculator Flash." TIMEOUT 5000 STATUS S
70 IF S<>0 END
80 PRINT TO C,"Your name (1-32 characters): "; TIMEOUT 5000 STATUS S
90 IF S<>0 END
100 LINE INPUT FROM C,U$ TIMEOUT 60000 STATUS S
110 IF S=5 GOTO 80
120 IF S=9 GOTO 80
130 IF S<>0 END
140 IF LEN(U$)=0 GOTO 80
150 PRINT TO C,"Welcome, "+U$+"!" TIMEOUT 5000 STATUS S
160 IF S=0 .RE=1
170 END
