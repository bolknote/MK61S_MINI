10 F=LOAD.("HighNoon")
20 IF F<1 G.9000
30 IF COLS<40 G.9000
40 X=.R0:C=.R2:P=.R3:T=.R4:.RE=99
100 C.:IN."WHAT IS YOUR STRATEGY?",B
110 IF B<1 G.900
120 IF B>6 G.900
125 IF B#INT(B) G.900
130 .R1=B
140 G.1000+B*100
900 C.:P."YOU SURE AREN'T GOING TO LIVE VERY"
910 P."LONG IF YOU CAN'T EVEN FOLLOW"
920 P."DIRECTIONS":PAU.:G.100
1100 C.:IN."HOW MANY PACES DO YOU ADVANCE:",S
1110 IF S<0 G.1180
1120 IF S>10 G.1160
1125 IF S#INT(S) G.1160
1130 X=X-S
1140 P."YOU ARE NOW ";X;" PACES APART."
1150 N=2:G.7000
1160 C.:P."NOBODY CAN WALK THAT FAST":PAU.
1170 G.1100
1180 C.:P."NONE OF THIS NEGATIVE STUFF PARTNER,"
1190 P."ONLY POSITIVE NUMBERS":PAU.:G.1100
1200 C.:P."THAT MOVE MADE YOU A PERFECT"
1210 P."STATIONARY TARGET":N=2:G.7000
1300 V=0:C=C+1
1310 IF C<=4 G.1350
1320 IF V=0 C.
1321 P."NICE GOING, ACE, YOU'VE RUN OUT OF"
1330 P."SHELLS. NOW BART WON'T SHOOT UNTIL"
1340 P."YOU TOUCH NOSES. YOU BETTER THINK OF"
1345 P."SOMETHING FAST. (LIKE RUN)":N=2:G.7000
1350 W=RND(10)-1
1360 IF W>SGN(X)*INT(ABS(X)/10) G.1800
1370 IF C=2 G.1820
1380 IF C=3 G.1840
1390 P."WHAT A LOUSY SHOT."
1391 IF C=4 V=1:G.1320
1392 IF P>4 N=3:G.7000
1393 P."YOU NOW HAVE ";4-C;" SHELLS TO"
1394 P."BART'S ";4-P;" SHELLS.":N=2:G.7000
1400 T=T+1
1410 IF T>3 G.1460
1415 IF T>3 G.1460
1420 C.:P."NOT A BAD MANEUVER, YOU THREW"
1430 P."BART'S STRATEGY OFF":N=2:G.7000
1460 C.:P."HOW MANY WATERING TROUGHS DO YOU"
1470 P."THINK ARE ON THIS STREET":N=1:G.7000
1500 C.:P."BLACK BART ACCEPTS. THE CONDITIONS"
1510 P."ARE THAT HE WON'T SHOOT YOU IF YOU"
1520 P."TAKE THE FIRST STAGE OUT OF TOWN"
1530 P."AND NEVER COME BACK"
1540 IN."AGREED? 1 YES 0 NO",H
1550 IF H=0 G.1590
1560 C.:P."A VERY WISE DECISION."
1570 P.:P."C.G. INC.":N=99:G.7000
1590 C.:P."OH WELL, BACK TO THE SHOWDOWN"
1595 N=1:G.7000
1600 C.:IN."HOW FAR DID YOU RUN?",A
1605 IF A#INT(A) G.1600
1610 IF A<50 G.1670
1620 C.:P."MAN, DID HE RUN. HE RAN SO FAST"
1630 P."EVEN DOGS COULDN'T CATCH HIM"
1640 P.:P."C.G. INC.":N=99:G.7000
1670 IF P>=4 G.1770
1680 C.:P."BLACK BART FIRES ";4-P;" SHELLS......."
1690 IF 4-P>1 G.1730
1700 P."HE GOT YOU RIGHT IN THE BACK. THATS"
1710 P."WHAT YOU DESERVE FOR RUNNING"
1720 P.:P."C.G. INC.":N=99:G.7000
1730 P."BLACK BART UNLOADED HIS GUN, ONCE"
1740 P."IN YOUR BACK AND ";3-P;" TIMES IN YOUR"
1750 P."A**. NOW YOU CAN'T EVEN REST IN"
1760 P."PEACE.":P.:P."C.G. INC.":N=99:G.7000
1770 C.:P."YOU WERE LUCKY, BART CAN ONLY THROW"
1780 P."HIS GUN AT YOU, HE DOESN'T HAVE ANY"
1790 P."SHELLS LEFT. YOU SHOULD REALLY BE"
1795 P."DEAD.":P.:P."C.G. INC.":N=99:G.7000
1800 C.:P."WHAT A SHOT, YOU GOT BLACK BART"
1810 P."RIGHT BETWEEN THE EYES.":N=80:G.7000
1820 C.:P."GRAZED BART IN THE RIGHT ARM"
1830 N=2:G.7000
1840 C.:P."HE'S HIT IN THE LEFT SHOULDER,"
1850 P."FORCING HIM TO USE HIS RIGHT HAND"
1860 P."TO SHOOT WITH":N=2:G.7000
1870 C.:P."THAT WAS YOUR LAST SHOT, YOU MISSED"
1880 N=2:G.7000
7000 .R0=X:.R2=C:.R3=P:.R4=T:.RE=99:PAU.:.RE=N:E.
9000 C.:P."HIGH NOON CANNOT CONTINUE"
9010 .RE=99:PAU.:E.
