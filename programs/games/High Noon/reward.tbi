30 IF COLS<40 G.9000
100 D=RND():C.
110 P."КАК МЭР ДОДЖ-СИТИ ОТ ИМЕНИ ВСЕХ"
120 P."ГОРОЖАН БЛАГОДАРЮ ВАС И ВРУЧАЮ"
130 P."НАГРАДУ ЗА УБИЙСТВО ЧЁРНОГО БАРТА:"
140 P."ЧЕК НА 20 000 ДОЛЛАРОВ.":PAU.
200 C.:GOSUB 8000
220 P."ЧЕК НОМЕР ";INT(1000*D);" ОТ ";INT(10+10*D);" АВГУСТА 1889"
230 P."КВИТАНЦИЯ КАССИРА - БАНК ДОДЖ-СИТИ"
240 P."ВЫПЛАТИТЬ ПРЕДЪЯВИТЕЛЮ"
250 P."СУММУ"
260 P."ДВАДЦАТЬ ТЫСЯЧ ДОЛЛАРОВ";
265 FOR I=1 TO COLS-30
266 P."-";
267 NEXT I:P."$20,000"
280 GOSUB 8000:PAU.
300 C.:P."НЕ ТРАТЬТЕ ВСЁ СРАЗУ."
310 P.:P."КРИС ГАЙЛО, 1970":.RE=99:PAU.:E.
8000 FOR I=1 TO COLS
8010 P."*";
8020 NEXT I:P.:RETURN
9000 C.:P."ИГРА НЕ МОЖЕТ ПРОДОЛЖАТЬСЯ"
9010 .RE=99:PAU.:E.
