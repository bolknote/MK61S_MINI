1 @(165)=0;@(166)=0;@(335)=0
2 FOR I=0 TO 7
3 D=@(344+I);J=@(163)+D;N=1
4 P=@(J);K=ABS(P)
5 IF K>6 G.17
6 IF K=0 J=J+D:N=N+1:G.4
7 IF P*@(164)<=0 G.17
8 IF K=5 G.15
9 IF K=3 IF (ABS(D)=9) OR (ABS(D)=11) G.15
10 IF K=4 IF (ABS(D)=1) OR (ABS(D)=10) G.15
11 IF N#1 G.17
12 IF K=6 G.15
13 IF K=1 IF (D=-9*@(164)) OR (D=-11*@(164)) G.15
14 G.17
15 @(165)=@(165)+1;IF K#1 @(166)=@(166)+1
16 @(335)=J
17 J=@(163)+@(336+I)
18 IF @(J)=2*@(164) @(165)=@(165)+1:@(166)=@(166)+1:@(335)=J
19 NEXT I
20 @(145)=@(145)-1;A=@(278+@(145));@(144)=A MOD 256;.RE=INT(A/256);E.
