1 M=@(160);F=M MOD 128;T=INT(M/128) MOD 128;Q=INT(M/16384)
2 P=@(F);S=SGN(P);C=@(T);E=0
3 IF ABS(P)=1 IF T=@(122) IF C=0 C=@(T-10*S):E=1
4 @(@(161))=M+131072*(C+6)+2097152*E
5 @(@(161)+1)=@(121)+16*@(122)+2048*@(123)+524288*(@(120)=1)+1048576*@(127)+134217728*(@(128)+2*@(129))+536870912*@(124)
6 @(F)=0;@(T)=P;IF E=1 @(T-10*S)=0
7 IF Q>0 @(T)=Q*S
8 IF ABS(P)=6 G.10
9 G.21
10 IF S=1 @(125)=T
11 IF S=-1 @(126)=T
12 B=1;IF S=-1 B=4
13 FOR I=0 TO 1;A=B*2^I;IF INT(@(121)/A) MOD 2=1 @(121)=@(121)-A
14 NEXT I
15 IF ABS(T-F)#2 G.21
16 A=21;IF S=-1 A=91
17 IF T>F A=A+7
18 @(A)=0;@((F+T)/2)=4*S
19 IF S=1 @(128)=1
20 IF S=-1 @(129)=1
21 FOR I=0 TO 3
22 A=1*2^I;J=21
23 IF I=0 J=28
24 IF I=2 J=98
25 IF I=3 J=91
26 IF INT(@(121)/A) MOD 2=0 G.28
27 IF (F=J) OR (T=J) @(121)=@(121)-A
28 NEXT I
29 @(122)=0;IF ABS(P)=1 IF ABS(T-F)=20 @(122)=(T+F)/2
30 @(123)=@(123)+1;IF (ABS(P)=1) OR (C#0) @(123)=0
31 @(127)=0;IF C#0 @(127)=T
32 IF S=-1 @(124)=@(124)+1
33 @(120)=-S
34 @(145)=@(145)-1;A=@(278+@(145));@(144)=A MOD 256;.RE=INT(A/256);E.
