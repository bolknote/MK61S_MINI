1 U=@(@(161));V=@(@(161)+1)
2 M=U MOD 131072;F=M MOD 128;T=INT(M/128) MOD 128;Q=INT(M/16384)
3 C=INT(U/131072) MOD 16-6;E=INT(U/2097152) MOD 2
4 P=@(T);S=SGN(P)
5 IF Q>0 P=S
6 @(F)=P;@(T)=C
7 IF E=1 @(T)=0:@(T-10*S)=C
8 IF ABS(P)#6 G.15
9 IF S=1 @(125)=F
10 IF S=-1 @(126)=F
11 IF ABS(T-F)#2 G.15
12 A=21;IF S=-1 A=91
13 IF T>F A=A+7
14 @(A)=4*S;@((F+T)/2)=0
15 @(121)=V MOD 16;@(122)=INT(V/16) MOD 128;@(123)=INT(V/2048) MOD 256
16 @(120)=2*(INT(V/524288) MOD 2)-1;@(127)=INT(V/1048576) MOD 128
17 @(128)=INT(V/134217728) MOD 2;@(129)=INT(V/268435456) MOD 2;@(124)=INT(V/536870912)
18 @(145)=@(145)-1;A=@(278+@(145));@(144)=A MOD 256;.RE=INT(A/256);E.
