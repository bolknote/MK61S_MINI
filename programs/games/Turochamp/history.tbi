5 IF (Q>0) OR (ABS(@(T))=1) OR (C#0) OR (V MOD 16#@(121)) G.12
6 A=(INT(F/10)-2)*8+F MOD 10-1
7 B=(INT(T/10)-2)*8+T MOD 10-1
8 C=184+INT(@(130)/4);D=@(130) MOD 4
9 IF D=0 @(C)=0
10 @(C)=@(C)+(A+64*B)*4096^D;@(130)=@(130)+1
11 @(145)=@(145)-1;A=@(278+@(145));@(144)=A MOD 256;.RE=INT(A/256);E.
12 @(130)=0;@(131)=@(122)
13 @(145)=@(145)-1;A=@(278+@(145));@(144)=A MOD 256;.RE=INT(A/256);E.
