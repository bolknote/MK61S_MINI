1 IF (COLS<26) OR (ROWS<9) G.15
2 L=@(317)
3 FOR I=0 TO 351;@(I)=0;NEXT I
4 FOR I=0 TO 119;@(I)=99;NEXT I
5 FOR R=2 TO 9;FOR F=1 TO 8;@(10*R+F)=0;NEXT F;NEXT R
6 FOR I=31 TO 38;@(I)=1;@(I+50)=-1;NEXT I
7 FOR I=21 TO 28;READ @(I);@(I+70)=-@(I);NEXT I
8 @(120)=1;@(121)=15;@(122)=0;@(123)=0;@(124)=1;@(125)=25;@(126)=95;@(133)=35;@(134)=0
9 @(181)=2;@(182)=8;@(130)=0;@(131)=0;@(132)=1;@(136)=0;@(144)=0;@(145)=0
10 @(317)=1;IF L=2 @(317)=2
11 @(318)=1
12 FOR I=336 TO 336+7;READ @(I);NEXT I
13 FOR I=344 TO 344+7;READ @(I);NEXT I
14 @(144)=0;.RE=15;E.
15 C.:P."НУЖЕН ЭКРАН 26x9":P."И ШРИФТ ТУРОЧЕМП":PAU.
16 .RE=99:E.
17 DATA 4,2,3,5,6,3,2,4
18 DATA -21,-19,-12,-8,8,12,19,21
19 DATA -11,-10,-9,-1,1,9,10,11
