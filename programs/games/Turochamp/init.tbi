1 FOR I=0 TO 351;@(I)=0;NEXT I
2 FOR I=0 TO 119;@(I)=99;NEXT I
3 FOR R=2 TO 9;FOR F=1 TO 8;@(10*R+F)=0;NEXT F;NEXT R
4 FOR I=31 TO 38;@(I)=1;@(I+50)=-1;NEXT I
5 FOR I=21 TO 28;READ @(I);@(I+70)=-@(I);NEXT I
6 @(120)=1;@(121)=15;@(122)=0;@(123)=0;@(124)=1;@(125)=25;@(126)=95;@(133)=35;@(134)=0
7 @(181)=2;@(182)=8;@(130)=0;@(131)=0;@(132)=1;@(136)=0;@(144)=0;@(145)=0
8 FOR I=336 TO 336+7;READ @(I);NEXT I
9 FOR I=344 TO 344+7;READ @(I);NEXT I
10 @(144)=0;.RE=15;E.
11 C.:P."НУЖЕН ЭКРАН 26x9":P."И ШРИФТ ТУРОЧЕМП":PAU.
