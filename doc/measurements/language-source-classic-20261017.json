  "defects_reproduced_and_fixed": [
    {
      "problem": "The USB Screen session held the exclusive OVERLAY arena and prevented Flash uploads and editor staging.",
      "fix": "Use an independent LifetimeBuffer for the session on native F411.",
      "regression": "tests/run_usb_screen_stage_arm_tests.py: old ELF conflict reproduced, final ELF passes USB-first and stage-first with separate byte ranges and lifetimes."
    },
    {
      "problem": "Comparing distant streamed string resources bounced a single Flash cache per byte and caused a watchdog reset.",
      "fix": "Compare bounded 64-byte spans and stop resource comparison immediately on mismatch.",
      "regression": "tests/language_source_stream_self_test.cpp: distant spans, bounded read counts, mismatch, I/O failure; both 65534-byte source-resource fixtures pass on Classic."
    },
    {
      "problem": "The second full-file editor draft snapshot exhausted stage space with a full System on 512-KiB NOR.",
      "fix": "Keep a per-page bank map, reuse unchanged pages and publish the new map after all changed pages are durable.",
      "regression": "tests/language_source_document_self_test.cpp: two distant edits need 129 pages rather than 256; failed partial writes, retry and truncation preserve the original. Hardware 65530-byte Save and Cancel pass in both languages."
    },
    {
      "problem": "Starting M61 below a cached SRCEDIT.APP fragmented RAM and prevented the larger VM APP from loading.",
      "fix": "Evict an idle APP before placing the new root M61 runtime; active/pinned calls refuse eviction.",
      "regression": "tests/run_m61_source_editor_arm_tests.py: old ELF fragmentation reproduced; final ELF admits APPs through 20480 bytes and preserves a live native APP. The physical editor-to-M61 IF scenario passes."
    }
