  "changes": [
    "RP2040 small-trig callee returns the packed64bit result, replacing the intermediate16byte aggregate.",
    "Tiny reduced sine uses a top16bit cubic correction with center error<1relativeQ63 unit.",
    "An ambiguous small sine tries a relativeQ70 correction with center error<1relativeQ63 unit before the general refinement.",
    "An ambiguous small cosine tries the certified Q70 decrement, whose error is<3Q70 units with a four-unit guard.",
    "Every undecided result retains the existing general refinement. No new lookup table."
  ],
  "analysis": {
    "targeted_slow_cos_cases": ".build/m0-cos70-v65-20261021/actual-slow-inputs.json",
    "finding": "All three slowcos cases select the sine kernel after quadrant reduction; their reduced exponents are-27,-10,-15.",
