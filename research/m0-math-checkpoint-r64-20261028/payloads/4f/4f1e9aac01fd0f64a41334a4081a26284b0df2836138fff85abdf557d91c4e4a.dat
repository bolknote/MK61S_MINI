.syntax unified
.cpu cortex-m0plus
.thumb
.section .text.bench_measure,"ax",%progbits
.macro MEASURE name,pending
.global \name
.type \name,%function
.thumb_func
\name:
 push {r4-r7,lr}
 sub sp,#28
 str r3,[sp,#0]
 mov r4,r0
 mov r5,r1
 movs r6,#3
 ldr r7,=0xd0000000
 ldr r0,[r5,#8]
 ldr r1,[r5,#12]
 ldr r2,[r5,#16]
 ldr r3,[r5,#20]
 ldr r5,=0xe000e018
 ldr r5,[r5]
 str r5,[sp,#4]
.if \pending
 /* New division begins immediately before the public AAPCS entry. */
 str r6,[r7,#0x64]
.endif
 blx r4
 ldr r2,=0xe000e018
 ldr r2,[r2]
 str r0,[sp,#8]
 str r1,[sp,#12]
 str r2,[sp,#16]
 ldr r3,[r7,#0x78]
 str r3,[sp,#20]
1:
 ldr r2,[r7,#0x78]
 movs r3,#1
 tst r2,r3
 beq 1b
 ldr r0,[r7,#0x60]
 ldr r1,[r7,#0x64]
 ldr r2,[r7,#0x74]
 /* Quotient is deliberately last: reading it clears DIRTY. */
 ldr r3,[r7,#0x70]
 ldr r4,[sp,#0]
 str r0,[r4,#20]
 str r1,[r4,#24]
 str r3,[r4,#28]
 str r2,[r4,#32]
 ldr r0,[sp,#8]
 str r0,[r4,#0]
 ldr r0,[sp,#12]
 str r0,[r4,#4]
 ldr r0,[sp,#4]
 str r0,[r4,#8]
 ldr r0,[sp,#16]
 str r0,[r4,#12]
 ldr r0,[sp,#20]
 str r0,[r4,#16]
 add sp,#28
 pop {r4-r7,pc}
.size \name,.-\name
.endm
MEASURE bench_measure_ready,0
MEASURE bench_measure_dirty,0
MEASURE bench_measure_pending,1
.global bench_noop
.type bench_noop,%function
.thumb_func
bench_noop:
 bx lr
.size bench_noop,.-bench_noop
.global bench_entry_csr
.type bench_entry_csr,%function
.thumb_func
bench_entry_csr:
 /* Must be first instruction; r7 is set by the measurement wrapper. */
 ldr r0,[r7,#0x78]
 movs r1,#0
 bx lr
.size bench_entry_csr,.-bench_entry_csr
.global bench_fault_entry
.type bench_fault_entry,%function
.thumb_func
bench_fault_entry:
 cpsid i
 ldr r0,=0x20041000
 mov sp,r0
 ldr r0,=bench_fault_bootsel
 bx r0
.size bench_fault_entry,.-bench_fault_entry
.global isr_hardfault
.thumb_set isr_hardfault,bench_fault_entry
.section .note.GNU-stack,"",%progbits
