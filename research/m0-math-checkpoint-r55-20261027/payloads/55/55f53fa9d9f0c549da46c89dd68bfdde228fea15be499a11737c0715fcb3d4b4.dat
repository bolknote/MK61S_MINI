{
  "old": ".macro ir_center_quotient\n mov r12,r0\n mov r5,r6\n uxth r6,r7\n lsrs r2,r7,#16\n muls r6,r2\n muls r2,r2\n lsrs r6,#15\n adds r2,r6\n movs r6,#9\n subs r6,r6,r3\n lsrs r2,r6\n ir_mul32 r0,r2,r0,r1,r3,r6,r4,r0,r2\n mov r4,r12\n mov r0,r1\n muls r0,r5\n subs r0,r4,r0\n cmp r0,r5\n blo .Lir_div_done\\@\n subs r0,r0,r5\n adds r1,#1\n cmp r0,r5\n blo .Lir_div_done\\@\n adds r1,#1\n.Lir_div_done\\@:\n mov r0,r1\n.endm\n",
  "new": ".macro ir_center_quotient\n.global mk61_m0_pow_center_refine_begin\n.hidden mk61_m0_pow_center_refine_begin\nmk61_m0_pow_center_refine_begin:\n // Exact N/center by a16-bit high estimate and one short refinement.\n // Existing512 seed certificates bound both unsigned products and prove\n // the refined estimate is at most one quotient unit below the result.\n mov r5,r6\n lsrs r2,r7,#16\n muls r2,r2\n movs r6,#9\n subs r6,r6,r3\n lsrs r2,r6\n lsrs r3,r0,#16\n lsrs r1,r2,#16\n muls r1,r3\n uxth r4,r2\n muls r4,r3\n lsrs r4,#16\n adds r1,r4\n lsrs r2,#13\n mov r12,r2\n mov r4,r1\n muls r4,r5\n subs r0,r0,r4\n mov r2,r12\n muls r2,r0\n lsrs r2,#19\n adds r1,r2\n muls r2,r5\n subs r0,r2\n cmp r0,r5\n blo .Lir_div_done\\@\n adds r1,#1\n.Lir_div_done\\@:\n mov r0,r1\n.endm\n"
}
