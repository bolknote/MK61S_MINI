"""Recompute real object fingerprints and compare every unaffected section."""
from pathlib import Path
import hashlib,importlib.util,json,sys
sys.dont_write_bytecode=True
W=Path(__file__).resolve().parent;ROOT=W.parents[1]
S=ROOT/'.build/m0-math-unified-pow-saturation-r55-20261027';P=ROOT/'.build/m0-math-unified-pow-rsqrt-center-r52-20261027'
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
assert not(W/'section-isolation.json').exists()
source=json.loads((S/'link-result.json').read_bytes());parent=json.loads((P/'link-result.json').read_bytes())
spec=importlib.util.spec_from_file_location('definition_only_object_fingerprint',S/'support/fingerprint.py');fp=importlib.util.module_from_spec(spec);spec.loader.exec_module(fp)
changed={'RP-merged-cpp.o':{'.m0_pow_refine_extension','.scratch_y.m0_pow_hot'},'RP-unified-native_eabi_m0_rp2040.S.o':{'.m0_pow_tiny_cold'}}
reports={};unchanged=[]
for name,row in source['outputs'].items():
 if not name.endswith('.o'):continue
 assert sha(S/name)==row['sha256']
 before=fp.image_fingerprint((P/name).read_bytes());after=fp.image_fingerprint((S/name).read_bytes());assert before==parent['outputs'][name]['fingerprint']and after==row['fingerprint']
 if name not in changed:
  assert before==after;unchanged.append(name);continue
 skip=changed[name]
 a=[r for r in before['allocated']if r[0]not in skip];b=[r for r in after['allocated']if r[0]not in skip];assert a==b,(name,'allocated')
 a=[r for r in before['symbols']if r[5]not in skip];b=[r for r in after['symbols']if r[5]not in skip];assert a==b,(name,'symbols')
 a=[r for r in before['relocations']if r[0]not in skip];b=[r for r in after['relocations']if r[0]not in skip];assert a==b,(name,'relocations')
 reports[name]=dict(changed_only_sections=sorted(skip),all_other_allocated_bytes_symbols_semantic_relocations_exact=True,unchanged_allocated_sections=sum(r[0]not in skip for r in before['allocated']),unchanged_semantic_relocation_rows=len(a))
assert len(unchanged)==21
out=dict(status='PASS_R55_ALL_UNAFFECTED_ALLOCATED_BYTES_SYMBOLS_AND_SEMANTIC_RELOCATIONS_EXACT_R52',source_FROZEN_sha256=sha(S/'FROZEN.json'),parent_source_FROZEN_sha256=sha(P/'FROZEN.json'),unchanged21_objects=unchanged,changed_object_unaffected_section_checks=reports,default_M0_M4_exact=True,division_sections_and_semantic_relocations_exact=True,new_ARM_MPFR_calls=0,hardware_accessed=False,goal_complete=False)
(W/'section-isolation.json').write_text(json.dumps(out,indent=2)+'\n');print(json.dumps(out,indent=2),flush=True)
