+// Checked small integer powers. No rounded intermediate doubles are used
+// for the positive power. Reciprocal candidates are independently checked
+// by multiplying both adjacent exact midpoints against the same enclosure.
+struct PowInteger128 {U high,low;int exponent;unsigned error;};
+
+__attribute__((optimize("Os"),noinline,noipa,section(".m0_pow_near_one_refine")))
+static void pow_integer128_multiply(PowInteger128 &a,const PowInteger128 &b) {
+  const U ah=a.high,al=a.low,bh=b.high,bl=b.low;
+  const int exponent=a.exponent+b.exponent;
+  unsigned error=a.error+b.error;
+  Product product=multiply(ah,bh);
+  if(al) {
+    const U previous=product.low;
+    product.low+=multiply(al,bh).high;product.high+=U(product.low<previous);
+  }
+  if(bl) {
+    const U previous=product.low;
+    product.low+=multiply(ah,bl).high;product.high+=U(product.low<previous);
+  }
+  // If both low words vanish, the mantissa product is exact. Otherwise
+  // omitting the low cross products loses <3units; operand errors and
+  // their product give the indicated conservative integer error radius.
+  error+=al&&bl?4:(al||bl?2:(error?1:0));
+  a.exponent=exponent;
+  if(product.high>>63) ++a.exponent;
+  else {
+    product.high=(product.high<<1)|(product.low>>63);product.low<<=1;
+    error<<=1;
+  }
+  a.high=product.high;a.low=product.low;a.error=error;
+}
+
+__attribute__((always_inline)) inline U pow_integer128_hint(const PowInteger128 &a) {
+  const U retained=a.high>>11,tail=a.high&2047U;
+  const bool up=tail>1024U || (tail==1024U && (a.low || (retained&1)));
+  return (U(a.exponent+1022)<<52)+retained+U(up);
+}
