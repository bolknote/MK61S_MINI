+// Compare two normalized enclosures, aligning only a one-bit exponent gap.
+__attribute__((optimize("Os"),noinline,noipa,section(".m0_pow_near_one_refine")))
+static int pow_dyadic128_compare(PowInteger128 a,PowInteger128 b) {
+  const int distance=a.exponent-b.exponent;
+  if(distance>=2) return 1;
+  if(distance<=-2) return -1;
+  if(distance<0) {
+    a.low=(a.low>>1)|(a.high<<63);a.high>>=1;a.error=(a.error>>1)+1;
+  } else if(distance>0) {
+    b.low=(b.low>>1)|(b.high<<63);b.high>>=1;b.error=(b.error>>1)+1;
+  }
+  if(a.high==b.high && a.low==b.low) return 0;
+  const bool smaller=a.high<b.high || (a.high==b.high && a.low<b.low);
+  const U ah=smaller?b.high:a.high,al=smaller?b.low:a.low;
+  const U bh=smaller?a.high:b.high,bl=smaller?a.low:b.low;
+  const U low=al-bl,high=ah-bh-U(al<bl);
+  if(high || low>U(a.error+b.error)) return smaller?-1:1;
+  return 0;
+}
+
+__attribute__((always_inline)) inline void pow_dyadic128_raise(PowInteger128 &q,unsigned n) {
+  const PowInteger128 base=q;
+  unsigned bit=31-clz32(n);
+  while(bit) {
+    --bit;
+    pow_integer128_multiply(q,q);
+    if(n&(1U<<bit)) pow_integer128_multiply(q,base);
+  }
+}
