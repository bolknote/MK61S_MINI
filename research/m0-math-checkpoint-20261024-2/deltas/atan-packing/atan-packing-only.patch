+  const uint32_t packed_high=(hi>>shift)|(q.high<<(32-shift));
+  result=sign+(U(unsigned(e+1022)-lower)<<52)+
+    ((U(packed_high)<<32)|packed_low)+U(tail>half);
+  return true;
+}
