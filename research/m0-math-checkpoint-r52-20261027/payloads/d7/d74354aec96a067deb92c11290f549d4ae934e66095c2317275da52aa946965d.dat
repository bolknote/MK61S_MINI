"""Rebuild R50 using pinned R49 commands; isolate one RP assembly section."""
from pathlib import Path
import hashlib, importlib.util, json, subprocess, sys
sys.dont_write_bytecode = True
assert getattr(sys, 'mk61_private_fixture', None)
from check_stm32_vectors import ElfImage
W = Path(__file__).resolve().parent
ROOT = W.parents[1]
P = ROOT / '.build/m0-math-unified-exp-incremental-r49-20261027'
def sha(p):
    return hashlib.sha256(p.read_bytes()).hexdigest()
assert sha(P/'FROZEN.json') == 'e9db8a83b36789ffd54d1586e60779502fb8ec4bd4b8381495f15abed8ebc15e'
assert not (W/'link-result.json').exists()
edits = json.loads((W/'source-edits.json').read_bytes())
for name,pin in edits['changed_source_files'].items():
    assert sha(W/name) == pin['after_sha256']
spec = importlib.util.spec_from_file_location('r50_pure_fingerprint', W/'support/fingerprint.py')
fp = importlib.util.module_from_spec(spec); spec.loader.exec_module(fp)
parent = json.loads((P/'link-result.json').read_bytes())
commands, outputs, unchanged = [], {}, []
def run(cmd):
    commands.append(cmd)
    result = subprocess.run(cmd, capture_output=True, text=True)
    with (W/'build.log').open('a') as log:
        log.write(result.stdout+result.stderr)
    assert result.returncode == 0, result.stderr
changed_sections = None
for recorded in parent['commands']:
    if '-c' not in recorded:
        continue
    cmd = [arg.replace(str(P)+'/', str(W)+'/') for arg in recorded]
    run(cmd)
    out = Path(cmd[cmd.index('-o')+1]); name = out.name
    current = fp.image_fingerprint(out.read_bytes())
    old = parent['outputs'][name]['fingerprint']
    if name == 'RP-merged-asm.o':
        before = {row[0]:row for row in old['allocated']}
        after = {row[0]:row for row in current['allocated']}
        assert before.keys() == after.keys()
        changed_sections = [name for name in before if before[name] != after[name]]
        assert changed_sections == ['.m0_pow_dispatch_extension'], changed_sections
    else:
        assert current == old, name
        unchanged.append(name)
    outputs[name] = dict(sha256=sha(out), fingerprint=current)
assert len(unchanged) == 22 and changed_sections
for recorded in parent['commands']:
    if '-c' in recorded:
        continue
    cmd = [arg.replace(str(P)+'/', str(W)+'/') for arg in recorded]
    run(cmd)
    out = Path(cmd[cmd.index('-o')+1])
    outputs[out.name] = dict(sha256=sha(out), fingerprint=fp.image_fingerprint(out.read_bytes()))
tc = Path(commands[0][0]).parent
images = {}
for label in ('candidate','zero-control'):
    path = W/(label+'.elf'); elf = ElfImage(path)
    assert not subprocess.check_output([str(tc/'arm-none-eabi-nm'),'-u',str(path)])
    assert elf.named_sections['.scratch_y'][5] == 4080
    assert elf.symbols['mk61_m0_pow_rsqrt_normal_eminus1'] == elf.symbols['mk61_m0_pow_rsqrt_fast'] + 4
    assert elf.symbols['mk61_m0_exp'] == elf.symbols['_ZN12compact_math3expEd']
    assert elf.named_sections['.rodata'][5] == 237424
    dis = subprocess.check_output([str(tc/'arm-none-eabi-objdump'),'-dr',str(path)],text=True)
    (W/(label+'.dis')).write_text(dis)
    images[label] = dict(ELF_sha256=sha(path), scratch_y_bytes=4080, all_undefined_symbols_resolved=True, native_rsqrt_entry_offset=4)
result = dict(status='BUILT_R50_NATIVE_RSQRT_ENTRY_PENDING_PROOF_AND_QUALIFICATION', images=images, commands=commands, outputs=outputs, parent_source_FROZEN_sha256=sha(P/'FROZEN.json'), unchanged_objects=unchanged,
    all22_other_original_objects_exact=True, changed_RP_object_sections=changed_sections, M4_default_objects_exact=True, new_lookup_table_global_RAM_libgcc_bytes=0,
    selected=False, new_native_entry_contract_proof_pending=True, mandatory_linked_source_guards_pending=True, hardware_accessed=False, integration_GO=False, goal_complete=False)
(W/'link-result.json').write_text(json.dumps(result,indent=2)+'\n')
print(json.dumps({k:v for k,v in result.items() if k not in ('commands','outputs')},indent=2),flush=True)
