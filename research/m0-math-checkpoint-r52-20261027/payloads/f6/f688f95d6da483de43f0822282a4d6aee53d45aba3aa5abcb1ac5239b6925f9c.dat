{
  "old": " // These two common factor words have exact shift/subtract products.\n // Every other word still uses the complete32x32 multiplication.\n ldr r2,=0x7fffffff\n cmp r0,r2\n beq .Lir_factor_below\n adds r2,#1\n cmp r0,r2\n beq .Lir_factor_equal\n ir_mul32 r0,r6,r0,r1,r2,r3,r4,r0,r1\n b .Lir_factor_product\n.Lir_factor_below:\n lsls r0,r6,#31\n lsrs r1,r6,#1\n subs r0,r0,r6\n movs r2,#0\n sbcs r1,r2\n b .Lir_factor_product\n",
  "new": " // Exact signed decomposition: Fhigh=2^31+D, |D|<=130.\n // The integer/rational seed certificate proves this for every normal x.\n ldr r2,=0x7fffffff\n subs r2,r0,r2\n beq .Lir_factor_below\n cmp r2,#1\n beq .Lir_factor_equal\n subs r0,r2,#1\n // Exact64-bit seed*D from two bounded signed16-bit partial products.\n // Low32 is one full MULS. Add the exact seed<<31 with ADD/ADC.\n uxth r2,r6\n muls r2,r0\n asrs r2,#16\n lsrs r1,r6,#16\n muls r1,r0\n adds r1,r2\n asrs r1,#16\n muls r0,r6\n lsls r2,r6,#31\n lsrs r3,r6,#1\n adds r0,r2\n adcs r1,r3\n b .Lir_factor_product\n.Lir_factor_below:\n // The incoming SUBS result is R2=0; both SBC and final ADC reuse it.\n lsls r0,r6,#31\n lsrs r1,r6,#1\n subs r0,r0,r6\n sbcs r1,r2\n adds r0,r7\n adcs r1,r2\n b mk61_m0_pow_rsqrt_point\n"
}
