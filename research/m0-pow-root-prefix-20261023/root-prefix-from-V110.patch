+ lsrs r7,r1,#23
+ cmp r2,#0
+ beq .Lroot64_even
+ movs r3,#1
+ lsls r3,#8
+ eors r7,r3
+ mov r4,r0
+ mov r5,r1
+ b .Lroot64_coordinate
+.Lroot64_even:
+ lsrs r4,r0,#1
+ lsls r5,r1,#31
+ orrs r4,r5
+ lsrs r5,r1,#1
+.Lroot64_coordinate:
+ mov lr,r4
+ lsrs r2,r0,#23
+ lsls r3,r1,#9
+ orrs r2,r3
+ movs r3,#1
+ lsls r3,#31
+ eors r2,r3
+ asrs r2,#11
+ adds r2,#1
+ asrs r2,#1
+ lsls r7,#4
+ ldr r4,=pow_sqrt64_coefficients
+ adds r7,r4
+ ldmia r7!,{r0,r1}
+ asrs r3,r1,#21
+ lsls r3,#3
+ lsls r1,#11
+ lsrs r1,#9
