+.syntax unified
+.cpu cortex-m0plus
+.thumb
+.macro sqrt64_polynomial
+ asrs r4,r2,#4
+ muls r3,r4
+ asrs r3,#16
+ adds r1,r3
+ lsls r3,r1,#20
+ lsrs r3,#20
+ muls r3,r2
+ asrs r3,#20
+ asrs r1,#12
+ muls r1,r2
+ asrs r1,#8
+ adds r1,r3
+ adds r0,r1
+.endm
+
+// Exact 32-bit square: R0 is retained, R4:R3 is the result.
+.macro sqrt64_square32 scratch
+ uxth r2,r0
+ lsrs r3,r0,#16
+ mov r4,r2
+ muls r4,r2
+ muls r2,r3
+ muls r3,r3
+ lsls \scratch,r2,#17
+ lsrs r2,#15
+ adds r4,\scratch
+ adcs r3,r2
+.endm
