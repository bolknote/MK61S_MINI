diff --git a/code/memcmp_m0.inc b/code/memcmp_m0.inc
new file mode 100644
index 000000000..6d8d065d4
--- /dev/null
+++ b/code/memcmp_m0.inc
@@ -0,0 +1,254 @@
+/* Bounded, read-only unsigned lexicographic comparison.
+ * Returns the ISO C sign; unequal word results may be -1 or +1.
+ * Generated from research/memcmp-2026-10-21/candidates.S by export.py. */
+".syntax unified\n"
+".cpu cortex-m0plus\n"
+".macro mk61_compare_byte_pair tag,mk61_compare_offset\n"
+" ldrb r3,[r0,#\\mk61_compare_offset]\n"
+" ldrb r4,[r1,#\\mk61_compare_offset]\n"
+" subs r3,r3,r4\n"
+" bne .Lmk61_compare_byteDiff\\tag\n"
+".endm\n"
+".macro mk61_compare_word_pair tag\n"
+" ldmia r0!,{r3}\n"
+" ldmia r1!,{r4}\n"
+" cmp r3,r4\n"
+" bne .Lmk61_compare_wordDiff\\tag\n"
+".endm\n"
+".macro mk61_compare_merged_pair tag,h\n"
+" ldmia r0!,{r3}\n"
+" ldmia r1!,{r6}\n"
+" lsls r4,r6,#(\\h*8)\n"
+" orrs r4,r5\n"
+" cmp r3,r4\n"
+" bne .Lmk61_compare_mergeDiff\\tag\\h\n"
+" lsrs r5,r6,#(32-\\h*8)\n"
+".endm\n"
+".macro mk61_compare_merge tag,h\n"
+".Lmk61_compare_merge\\tag\\h:\n"
+" push {r5,r6}\n"
+" .if \\h==1\n"
+" ldrb r5,[r1]\n"
+" .elseif \\h==2\n"
+" ldrh r5,[r1]\n"
+" .else\n"
+" ldrb r5,[r1]\n"
+" adds r1,#1\n"
+" ldrh r4,[r1]\n"
+" lsls r4,r4,#8\n"
+" orrs r5,r4\n"
+" .endif\n"
+" .if \\h==3\n"
+" adds r1,#2\n"
+" .else\n"
+" adds r1,#\\h\n"
+" .endif\n"
+" subs r2,#(4+\\h)\n"
+" cmp r2,#12\n"
+" blo .Lmk61_compare_mergeWord\\tag\\h\n"
+" subs r2,#12\n"
+".Lmk61_compare_merge16\\tag\\h:\n"
+" .rept 4\n"
+" mk61_compare_merged_pair \\tag,\\h\n"
+" .endr\n"
+" subs r2,#16\n"
+" bhs .Lmk61_compare_merge16\\tag\\h\n"
+" adds r2,#12\n"
+" bcc .Lmk61_compare_mergeTail\\tag\\h\n"
+".Lmk61_compare_mergeWord\\tag\\h:\n"
+" mk61_compare_merged_pair \\tag,\\h\n"
+" subs r2,#4\n"
+" bhs .Lmk61_compare_mergeWord\\tag\\h\n"
+".Lmk61_compare_mergeTail\\tag\\h:\n"
+" /* The carry contains exactly h bytes already read inside the span. */\n"
+" .rept \\h\n"
+" ldrb r3,[r0]\n"
+" uxtb r4,r5\n"
+" subs r3,r3,r4\n"
+" bne .Lmk61_compare_mergeByteDiff\\tag\\h\n"
+" adds r0,#1\n"
+" lsrs r5,r5,#8\n"
+" .endr\n"
+" adds r2,#4\n"
+" pop {r5,r6}\n"
+" b .Lmk61_compare_tail\\tag\n"
+".Lmk61_compare_mergeDiff\\tag\\h:\n"
+" pop {r5,r6}\n"
+" b .Lmk61_compare_wordDiff\\tag\n"
+".Lmk61_compare_mergeByteDiff\\tag\\h:\n"
+" pop {r5,r6}\n"
+" b .Lmk61_compare_byteDiff\\tag\n"
+".endm\n"
+".macro mk61_compare_compare name,words\n"
+" cmp r2,#0\n"
+" beq .Lmk61_compare_zero\\name\n"
+" cmp r0,r1\n"
+" beq .Lmk61_compare_zero\\name\n"
+" mov r12,r0\n"
+" ldrb r0,[r0]\n"
+" ldrb r3,[r1]\n"
+" subs r0,r0,r3\n"
+" bne .Lmk61_compare_return\\name\n"
+" cmp r2,#1\n"
+" beq .Lmk61_compare_return\\name\n"
+" mov r0,r12\n"
+" cmp r2,#8\n"
+" blo .Lmk61_compare_small\\name\n"
+" movs r3,r0\n"
+" eors r3,r1\n"
+" lsls r3,r3,#30\n"
+" beq .Lmk61_compare_prepare\\name\n"
+" .if \\words>1\n"
+" cmp r2,#24\n"
+" bhs .Lmk61_compare_prepare\\name\n"
+" .endif\n"
+".Lmk61_compare_small\\name:\n"
+" push {r4}\n"
+" /* Byte zero was checked before any register save or word-loop setup. */\n"
+" adds r0,#1\n"
+" adds r1,#1\n"
+" subs r2,#1\n"
+" .if \\words>1\n"
+" cmp r2,#4\n"
+" blo .Lmk61_compare_smallTail\\name\n"
+".Lmk61_compare_smallFour\\name:\n"
+" mk61_compare_byte_pair \\name,0\n"
+" mk61_compare_byte_pair \\name,1\n"
+" mk61_compare_byte_pair \\name,2\n"
+" mk61_compare_byte_pair \\name,3\n"
+" adds r0,#4\n"
+" adds r1,#4\n"
+" subs r2,#4\n"
+" cmp r2,#4\n"
+" bhs .Lmk61_compare_smallFour\\name\n"
+".Lmk61_compare_smallTail\\name:\n"
+" cmp r2,#0\n"
+" beq .Lmk61_compare_equal\\name\n"
+" .endif\n"
+".Lmk61_compare_smallByte\\name:\n"
+" mk61_compare_byte_pair \\name,0\n"
+" adds r0,#1\n"
+" adds r1,#1\n"
+" subs r2,#1\n"
+" bne .Lmk61_compare_smallByte\\name\n"
+".Lmk61_compare_equal\\name:\n"
+" movs r3,#0\n"
+".Lmk61_compare_byteDiff\\name:\n"
+" movs r0,r3\n"
+" pop {r4}\n"
+".Lmk61_compare_return\\name:\n"
+" bx lr\n"
+".Lmk61_compare_zero\\name:\n"
+" movs r0,#0\n"
+" bx lr\n"
+".Lmk61_compare_prepare\\name:\n"
+" push {r4}\n"
+" lsls r3,r0,#30\n"
+" beq .Lmk61_compare_aligned\\name\n"
+" /* Skip the already checked first byte before aligning the left span. */\n"
+" adds r0,#1\n"
+" adds r1,#1\n"
+" subs r2,#1\n"
+" lsls r3,r0,#30\n"
+" beq .Lmk61_compare_aligned\\name\n"
+".Lmk61_compare_prefix\\name:\n"
+" mk61_compare_byte_pair \\name,0\n"
+" adds r0,#1\n"
+" adds r1,#1\n"
+" subs r2,#1\n"
+" lsls r3,r0,#30\n"
+" bne .Lmk61_compare_prefix\\name\n"
+".Lmk61_compare_aligned\\name:\n"
+" .if \\words>1\n"
+" lsls r3,r1,#30\n"
+" beq .Lmk61_compare_words\\name\n"
+" movs r3,#3\n"
+" ands r3,r1\n"
+" cmp r3,#1\n"
+" bne .Lmk61_compare_not3\\name\n"
+" b .Lmk61_compare_merge\\name\\()3\n"
+".Lmk61_compare_not3\\name:\n"
+" cmp r3,#2\n"
+" bne .Lmk61_compare_not2\\name\n"
+" b .Lmk61_compare_merge\\name\\()2\n"
+".Lmk61_compare_not2\\name:\n"
+" b .Lmk61_compare_merge\\name\\()1\n"
+" .else\n"
+" b .Lmk61_compare_words\\name\n"
+" .endif\n"
+".Lmk61_compare_wordDiff\\name:\n"
+" rev r0,r3\n"
+" rev r1,r4\n"
+" cmp r0,r1\n"
+" sbcs r0,r0\n"
+" movs r1,#1\n"
+" orrs r0,r1\n"
+" pop {r4}\n"
+" bx lr\n"
+".Lmk61_compare_words\\name:\n"
+" .if \\words>1\n"
+" cmp r2,#(4*\\words)\n"
+" .if \\words>4\n"
+" blo .Lmk61_compare_medium\\name\n"
+" .else\n"
+" blo .Lmk61_compare_word\\name\n"
+" .endif\n"
+".Lmk61_compare_bulk\\name:\n"
+" .rept \\words\n"
+" mk61_compare_word_pair \\name\n"
+" .endr\n"
+" subs r2,#(4*\\words)\n"
+" cmp r2,#(4*\\words)\n"
+" bhs .Lmk61_compare_bulk\\name\n"
+" .if \\words>4\n"
+".Lmk61_compare_medium\\name:\n"
+" cmp r2,#16\n"
+" blo .Lmk61_compare_wordCheck\\name\n"
+".Lmk61_compare_16\\name:\n"
+" .rept 4\n"
+" mk61_compare_word_pair \\name\n"
+" .endr\n"
+" subs r2,#16\n"
+" cmp r2,#16\n"
+" bhs .Lmk61_compare_16\\name\n"
+".Lmk61_compare_wordCheck\\name:\n"
+" .endif\n"
+" cmp r2,#4\n"
+" blo .Lmk61_compare_tail\\name\n"
+" .endif\n"
+".Lmk61_compare_word\\name:\n"
+" mk61_compare_word_pair \\name\n"
+" subs r2,#4\n"
+" cmp r2,#4\n"
+" bhs .Lmk61_compare_word\\name\n"
+".Lmk61_compare_tail\\name:\n"
+" cmp r2,#0\n"
+" beq .Lmk61_compare_wordEqual\\name\n"
+".Lmk61_compare_tailByte\\name:\n"
+" ldrb r3,[r0]\n"
+" ldrb r4,[r1]\n"
+" subs r3,r3,r4\n"
+" bne .Lmk61_compare_tailDiff\\name\n"
+" adds r0,#1\n"
+" adds r1,#1\n"
+" subs r2,#1\n"
+" bne .Lmk61_compare_tailByte\\name\n"
+".Lmk61_compare_wordEqual\\name:\n"
+" movs r3,#0\n"
+".Lmk61_compare_tailDiff\\name:\n"
+" movs r0,r3\n"
+" pop {r4}\n"
+" bx lr\n"
+" .if \\words>1\n"
+" mk61_compare_merge \\name,3\n"
+" mk61_compare_merge \\name,2\n"
+" mk61_compare_merge \\name,1\n"
+" .endif\n"
+".endm\n"
+"\n"
+"mk61_compare_compare body,16\n"
+".purgem mk61_compare_compare\n"
+".purgem mk61_compare_word_pair\n"
+".purgem mk61_compare_byte_pair\n"
+".purgem mk61_compare_merged_pair\n"
+".purgem mk61_compare_merge\n"
