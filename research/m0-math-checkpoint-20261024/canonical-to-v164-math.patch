+ movs r3,#1
+ lsls r3,#8
+ eors r7,r3
+ mov r4,r0
+ mov r5,r1
+ b .Lroot64_coordinate
+.Lroot64_even:
+ lsrs r4,r0,#1
+ lsls r5,r1,#31
+ orrs r4,r5
+ lsrs r5,r1,#1
+.Lroot64_coordinate:
+ mov lr,r4
+ lsrs r2,r0,#23
+ lsls r3,r1,#9
+ orrs r2,r3
+ movs r3,#1
+ lsls r3,#31
+ eors r2,r3
