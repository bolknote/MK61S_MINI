+ orrs r1,r2
+ lsls r0,#11
+ asrs r7,#6
+ lsrs r6,#16
+ muls r7,r6
+ asrs r7,#19
+ asrs r2,r7,#31
+ adds r0,r7
+ adcs r1,r2
