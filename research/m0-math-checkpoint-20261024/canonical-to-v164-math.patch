+.macro sqrt64_square32 scratch
+ uxth r2,r0
+ lsrs r3,r0,#16
+ mov r4,r2
+ muls r4,r2
+ muls r2,r3
+ muls r3,r3
+ lsls \scratch,r2,#17
+ lsrs r2,#15
+ adds r4,\scratch
+ adcs r3,r2
+.endm
