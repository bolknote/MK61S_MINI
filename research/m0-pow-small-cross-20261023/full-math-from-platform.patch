+    return qint_tod (&qZ);
+  }
+
+  /* We can end up here for x^y very close to 1. For |qR| < 2^-55,
+     we have 1-2^-54 < exp(qR) < 1+2^-53, thus exp(qR) rounds either
+     to nextbelow(1), to 1 or to nextabove(1). */
