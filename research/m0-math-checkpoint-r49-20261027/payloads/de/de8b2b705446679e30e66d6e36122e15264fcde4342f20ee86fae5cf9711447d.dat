"""Algebraic word-prefix maxima for omitted ADCs and fixed helper frames."""
from pathlib import Path
import hashlib,json,sys
sys.dont_write_bytecode=True
W=Path(__file__).resolve().parent
B=1<<16;d=B-1;a3=(1<<14)-1
c2=(d*d+2*d*d)>>16
c3prefix=c2+2*d*a3
c3=(c3prefix+2*d*d)>>16
c4prefix=c3+2*d*a3
c4=(c4prefix+d*d)>>16
c5=c4+2*d*a3
assert max(c3prefix,c4prefix,c5)<1<<32
assert a3*a3+(c5>>16)<1<<28
square_maxima=dict(column3_prefix=c3prefix,column4_prefix=c4prefix,column5_total=c5)
p1=p2=d*21845;p3=15*21845
s=3*d+15
qsmall=s//3
tmid=p2+p3;tlow=p1+tmid+qsmall
assert tmid<1<<31 and tlow<1<<32
a3=(1<<15)-1;b3=7
c3=(d*b3+2*d*d+a3*d)>>16
c4prefix=c3+d*b3
c4=(c4prefix+d*d+a3*d)>>16
c5=c4+d*b3+a3*d
c6=(c5>>16)+a3*b3
assert c4prefix<1<<32 and c5<1<<32 and c6<1<<20
assert ((1<<14)-1)**2<1<<28
assert ((((1<<14)-1)**3)>>27)*1456<1<<32
report=dict(status='PASS_Q85_WORD_CLOSURE_AND_FIXED_FRAMES',square_prefix_maxima=square_maxima,divide3_maxima=dict(tmid=tmid,tlow=tlow),product64_maxima=dict(column4_prefix=c4prefix,column5_total=c5,column6=c6),small_exp_frame=72,max_leaf_frame=40,small_fast_stack_bound=112,no_recursion_or_dynamic_allocation=True,all_private_BL_sites_stack_aligned8=True,leaf_push20_may_have_internal4alignment_without_calls=True,all_removed_carries_have_unsigned_prefix_less2p32=True,returned_helper_domains=dict(square='a<2^62',divide3='N<2^52',multiply_high32='a,b<2^32',product64='a<2^63,b<2^51'),actual_source_sha256=hashlib.sha256((W/'small.S').read_bytes()).hexdigest(),new_ARM_MPFR_calls=0,hardware_accessed=False,integration_GO=False,goal_complete=False)
(W/'integer-closure.json').write_text(json.dumps(report,indent=2)+'\n');print(json.dumps(report,indent=2))
