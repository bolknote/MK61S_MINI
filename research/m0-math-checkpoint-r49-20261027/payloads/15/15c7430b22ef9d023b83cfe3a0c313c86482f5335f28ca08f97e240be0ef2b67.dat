.syntax unified
.cpu cortex-m0plus
.thumb
.section .text.q73_incremental,"ax",%progbits
.balign 4
/* PRIVATE ABI: r0 is the live caller frame, r1=root raw column4,
 * r2=rounded Q73 low word. Return 2/below, 1/above, 0/decline.
 * Called only for a near-midpoint, admitted negative residual. */
.global mk61_q73_incremental_side
.type mk61_q73_incremental_side,%function
.thumb_func
mk61_q73_incremental_side:
 push {r4-r7,lr}
 sub sp,#20
 mov r7,r0
 lsls r4,r1,#23
 lsrs r4,r4,#22
 str r4,[sp,#0]
 lsls r5,r2,#11
 asrs r5,r5,#1
 str r5,[sp,#4]
 /* 4*RL-RQ, formed exactly modulo32 then interpreted as signed. */
 ldr r0,[r7,#52]
 lsls r0,r0,#2
 ldr r1,[r7,#64]
 subs r0,r1
 ldr r1,[r7,#80]
 ldr r2,[r7,#72]
 subs r1,r2
 lsls r2,r1,#1
 adds r1,r2
 lsls r1,r1,#24
 adds r0,r1
 asrs r0,r0,#14
 ldr r1,=21845
 muls r0,r1
 asrs r0,r0,#16
 str r0,[sp,#8]
 /* Coarse cubic correction is downward; only its upper error widens. */
 ldr r0,[r7,#88]
 lsrs r1,r0,#13
 ldr r2,=4369
 muls r1,r2
 lsrs r1,r1,#16
 ldr r2,=122880
 muls r1,r2
 subs r0,r1
 ldr r1,=2184
 muls r0,r1
 lsrs r0,r0,#18
 ldr r1,[sp,#8]
 adds r0,r1
 ldr r1,[r7,#68]
 muls r0,r1
 asrs r0,r0,#20
 str r0,[sp,#8]
 /* Missing low product columns: two MUL16, with the real carry. */
 ldr r0,[r7,#64]
 ldr r1,[r7,#92]
 uxth r2,r0
 lsrs r3,r0,#16
 uxth r4,r1
 lsrs r5,r1,#16
 movs r6,#0
 muls r2,r5
 muls r3,r4
 adds r2,r3
 adcs r6,r6
 lsrs r2,r2,#26
 lsls r6,r6,#6
 orrs r2,r6
 ldr r0,[r7,#96]
 adds r0,r2
 ldr r1,[sp,#8]
 adds r0,r1
 mov r6,r0
 /* R83-r73*1024, using STEP108=STEP96*4096-832. */
 ldr r0,[r7,#100]
 lsls r0,r0,#9
 lsrs r0,r0,#3
 ldr r1,[r7,#12]
 movs r2,#13
 muls r1,r2
 subs r0,r1
 asrs r0,r0,#19
 rsbs r0,r0,#0
 ldr r1,[r7,#84]
 lsls r1,r1,#22
 lsrs r1,r1,#22
 adds r0,r1
 subs r6,r0,r6
 /* Root fraction and the 9-bit approximation of A/Q73. */
 ldr r4,[r7,#104]
 lsls r4,r4,#11
 lsrs r4,r4,#22
 ldr r0,[r7,#40]
 muls r0,r6
 asrs r0,r0,#9
 adds r0,r4
 ldr r1,[sp,#0]
 subs r0,r1
 ldr r1,[sp,#4]
 adds r0,r1
 /* Strict interval is (centre-45, centre+23). */
 cmp r0,#45
 bge .Linc_above
 movs r1,#23
 rsbs r1,r1,#0
 cmp r0,r1
 ble .Linc_below
 movs r0,#0
 b .Linc_return
.Linc_above:
 movs r0,#1
 b .Linc_return
.Linc_below:
 movs r0,#2
.Linc_return:
 add sp,#20
 pop {r4-r7,pc}
.size mk61_q73_incremental_side,.-mk61_q73_incremental_side
.ltorg
