"""Pure model assembled from frozen function ASTs, without running producers."""
from pathlib import Path
from fractions import Fraction as F
import ast,importlib.util,sys
sys.dont_write_bytecode=True
W=Path(__file__).resolve().parent;ROOT=W.parents[1]
P=ROOT/'.build/m0-exp-q85-small-20261027'
spec=importlib.util.spec_from_file_location('q85_parent_model',P/'model.py')
parent=importlib.util.module_from_spec(spec);spec.loader.exec_module(parent)
m=parent.parent;Q=1<<83;U=F(3,1<<14)
H=ROOT/'.build/m0-exp-q83-general-host-study-20261027'
tree=ast.parse((H/'study.py').read_text())
functions=ast.Module(body=[n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name in ('divide3','retained','evaluate')],type_ignores=[])
scope=dict(F=F,m=m,Q=Q,U=U)
exec(compile(functions,str(H/'study.py'),'exec'),scope)
def divide3(a):
    assert 0<=a<1<<48
    p0=(a&65535)*21845;p1=((a>>16)&65535)*21845;p2=(a>>32)*21845
    return (p2<<16)+p1+p2+((p0+p1+p2)>>16)
scope['divide3']=divide3
general_evaluate=scope['evaluate'];retained=scope['retained']
def evaluate(x):
    result=general_evaluate(x)
    return result if result is not None else parent.evaluate(x)
