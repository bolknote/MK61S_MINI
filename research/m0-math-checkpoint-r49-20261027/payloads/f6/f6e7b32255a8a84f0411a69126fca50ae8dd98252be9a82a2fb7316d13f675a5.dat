"""Pure models from frozen Q85 and incremental function ASTs."""
from pathlib import Path
from fractions import Fraction as F
import ast,importlib.util,sys
sys.dont_write_bytecode=True
W=Path(__file__).resolve().parent;ROOT=W.parents[1]
P=ROOT/'.build/m0-exp-q85-small-20261027'
spec=importlib.util.spec_from_file_location('inc_q85_parent',P/'model.py')
parent=importlib.util.module_from_spec(spec);spec.loader.exec_module(parent)
m=parent.parent;Q=1<<73;U=F(3,1<<14)
H=ROOT/'.build/m0-exp-q73-incremental-ratio9-host-20261027'
tree=ast.parse((H/'study.py').read_text())
functions=ast.Module(body=[n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name in ('retained','divide15','small_div3','evaluate')],type_ignores=[])
scope=dict(F=F,m=m,Q=Q,U=U)
exec(compile(functions,str(H/'study.py'),'exec'),scope)
incremental_evaluate=scope['evaluate']
def evaluate(x):
    v=parent.evaluate(x)
    if v['kind']=='ambiguous':
        q=incremental_evaluate(x)
        if q is not None:return q
    return v
