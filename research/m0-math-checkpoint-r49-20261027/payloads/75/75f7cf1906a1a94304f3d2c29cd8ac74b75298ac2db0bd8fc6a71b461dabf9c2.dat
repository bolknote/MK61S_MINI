"""Actual source/prototype numeric image and long-veneer correspondence."""
from pathlib import Path
from collections import Counter
import ast,hashlib,json,re,struct,sys
sys.dont_write_bytecode=True
from check_stm32_vectors import ElfImage
W=Path(__file__).resolve().parent;ROOT=W.parents[1]
P=ROOT/'.build/m0-exp-q73-incremental-r2-20261027'
a=ElfImage(W/'candidate.elf');o=ElfImage(P/'candidate.elf')
layout=json.loads((W/'prototype-layout-comparison.json').read_text())
assert all(v['exact']for k,v in layout['allocated'].items()if k!='.scratch_y')
sec=a.named_sections['.scratch_y'];base=sec[3]
newbank=a.bytes_at(sec);oldbank=o.bytes_at(o.named_sections['.scratch_y'])
assert len(newbank)==len(oldbank)==4080
prefix=bytes.fromhex('01b40248844601bc6047');tail=4000
for bank in (newbank,oldbank):
    for at in range(tail,4080,16):
        assert bank[at:at+10]==prefix
        assert bank[at+10:at+12]in(bytes.fromhex('00bf'),bytes.fromhex('c046'))
assert Counter(newbank[i:i+16]for i in range(tail,4080,16))==Counter(oldbank[i:i+16]for i in range(tail,4080,16))
fn=next(n for n in ast.parse((W/'verify-private-return.py').read_text()).body if isinstance(n,ast.FunctionDef)and n.name=='parse')
scope={'re':re};exec(compile(ast.Module(body=[fn],type_ignores=[]),'actual_parser','exec'),scope)
new=scope['parse']((W/'candidate.dis').read_text());old=scope['parse']((P/'candidate.dis').read_text())
changed={i for i in range(tail)if newbank[i]!=oldbank[i]};covered=set();calls=[]
for address,row in old.items():
    off=address-base
    if not 0<=off<tail:continue
    positions=set(range(off,off+row['bytes']))
    if not changed&positions:continue
    nr=new[address]
    assert row['mnemonic']==nr['mnemonic']=='bl'and row['bytes']==nr['bytes']==4
    x=int(row['operands'].split()[0],16);y=int(nr['operands'].split()[0],16)
    assert x>=base+tail and y>=base+tail and (x-base-tail)%16==(y-base-tail)%16==0
    old_stub=oldbank[x-base:x-base+16];new_stub=newbank[y-base:y-base+16]
    assert old_stub==new_stub
    dest=struct.unpack('<I',old_stub[12:])[0]
    names=[n for n,v in a.symbols.items()if(v&~1)==(dest&~1)]
    calls.append(dict(call=hex(address),old_stub=hex(x),new_stub=hex(y),identical_absolute_callee=hex(dest),callee_symbols=names))
    covered|=positions
assert changed<=covered and len(calls)==5
for n in ('__scratch_y_source__','__data_source__','__data_start__','__data_end__','__bss_start__','__bss_end__'):
    assert a.symbols[n]==o.symbols[n],n
assert a.symbols['mk61_m0_exp']==o.symbols['mk61_q73_exp']
assert a.symbols['mk61_m0_exp_fallback']==o.symbols['mk61_m0_exp']
report=dict(status='PASS_SOURCE_INTEGRATION_NUMERICAL_CODE_AND_BANK_VENEER_EQUIVALENCE',text_rodata_data_bss_and_other_allocated_sections_exact=True,public_entry_and_fallback_addresses_mapped=True,all_changed_front_bytes_only_5_BL32_to_permuted_identical_stubs=True,calls=calls,identical_5_stub_multiset_and_ABI_prefix=True,stub_prefix_semantics='push r0; ldr absolute target; mov r12,r0; pop r0; bx r12; nop; flags preserved, original LR untouched',callee_address_registers_SP_stack_writes_and_return_LR_equal_after_stub=True,executed_instruction_counts_preserved_by_stub_permutation=True,no_physical_cycle_equivalence_claim=True,no_whole_library_acceptance_GO=True,new_ARM_MPFR_calls=0,hardware_accessed=False,integration_GO=False,goal_complete=False)
(W/'prototype-bank-equivalence-proof.json').write_text(json.dumps(report,indent=2)+'\n');print(json.dumps(report,indent=2))
