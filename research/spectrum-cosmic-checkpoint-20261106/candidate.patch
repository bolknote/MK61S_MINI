+#define SPECTRUM_PACING_TEST_ENTRY old_pacing_tests
+#include "spectrum_pacing_self_test.c"
+static void physical_acceptances(bool one_busy,bool one_early) {
+    paced_trace state;begin(&state,0,0);
+    for(unsigned n=0;n<=3000;++n) {
+        machine.frames=100+n;machine.frame_tstates=23;machine.cpu.cyc=machine.frames*71680UL+23;
+        paced_ready(&machine);machine.cpu.cyc+=13977;machine.frame_tstates=14000;
+        const uint32_t target=n*20480;test_clock=target; 
+        paced_boundary(&machine,target,target,target-1000,false);
+        test_clock=one_early && n==1500?target-1:target+100+(n%7)*17;
+        paced_present(one_busy && n==301?2:1);
+    }
+    assert(state.done && state.records==3001 && state.presents==(one_busy?3000U:3001U));
+    assert(done_records==3001 && done_timestamp==state.last_accepted);
+    assert(state.busy==(one_busy?1U:0U) && state.early==(one_early?1U:0U));
+    assert(!state.skipped && !state.repeated && !state.faults);
+    unsigned accepted=0,busy=0;for(unsigned i=0;i<10;++i) {accepted+=state.accepted[i].accepted;busy+=state.accepted[i].busy;}
+    assert(accepted==state.presents && busy==state.busy && state.max_ahead==13977);
+    assert(steady.cycles==3000U*71680 && state.exec_last-state.exec_first==3000U*71680);
+    if(!one_busy && !one_early)for(unsigned i=0;i<10;++i) {
+        assert(state.accepted[i].min_interval==20378 && state.accepted[i].max_interval==20497);
+        assert(state.accepted[i].max_late==202);
+    }
+    observed_end(&machine);
+    assert(strstr(output,"SPEXEC 3000 215040000 14000/14000 13977"));
+}
+int main(int argc,char** argv) {
+    char* args[]={"pacing",NULL};old_pacing_tests(1,args);
+    physical_acceptances(false,false);
+    if(argc==2) {FILE* f=fopen(argv[1],"wb");assert(f && fwrite(output,1,used,f)==used);assert(!fclose(f));}
+    physical_acceptances(true,false);physical_acceptances(false,true);
+    paced_trace state;begin(&state,0,0);state.started=true;state.present_target=0;
+    state.present_frame=100;test_clock=100;paced_present(1);
+    state.present_frame=102;test_clock=200;paced_present(1);
+    state.present_frame=102;test_clock=300;paced_present(1);
+    assert(state.records==3 && state.presents==3 && state.skipped==1 && state.repeated==1);
+    puts("Presentation metrology: all3001 API endpoints/3000 intervals, separate frozen/computed guest clocks, per-window accepted timestamps/minmax/busy, explicit early/busy failures PASS; physical scanout not measured");
