"""Directed error lemmas for n=0; reuse the pinned v2 constants/word proof."""
from pathlib import Path
from fractions import Fraction as F
import ast,hashlib,json,sys
sys.dont_write_bytecode=True
W=Path(__file__).resolve().parent;ROOT=W.parents[1]
P=ROOT/'.build/m0-exp-q73-public-v2-20261027'
sys.path.insert(0,str(W));import model as m
assert not(W/'strict-bounds-proof.json').exists()
ES=1+F(3,512);EP=1+F(1,8)
tree=ast.parse((P/'prove-model.py').read_text())
fn=ast.Module(body=[n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name=='error'],type_ignores=[])
scope=dict(F=F,ES=ES,EP=EP,m=m);exec(compile(fn,str(P/'prove-model.py'),'exec'),scope);error=scope['error']
def cubic_error(u):
    return u*(1<<16)/120+ES*u/F(120*(1<<21))+u*u*(1<<26)/120+F(1,15)+1+F((1<<18)-1,15*(1<<16))
def negative_bounds(u):
    ratio=u*u*(1<<21)
    tail=u/6+u*u/24+u*u*u/120
    below=ES*tail+ratio*(2+cubic_error(u))+EP
    above=ES/2+F(1,2)+ratio*(2+ES/F(3*(1<<24)))+u**6*m.Q/(720*(1-u/7))
    return below,above
def pair(v):return[v.numerator,v.denominator]
classes=[]
for tag,u,positive,negative in [('e_le_minus13',F(1,1<<12),3,2),('e_eq_minus12',F(1,1<<11),6,3),('e_eq_minus11_n0',F(7,10000),10,6)]:
    pos=error(u,F(0));below,above=negative_bounds(u)
    assert pos<positive and below<negative and above<negative,(tag,pos,below,above)
    classes.append(dict(input_class=tag,U=pair(u),positive_error_upper=pair(pos),positive_open_error_interval=[0,positive],negative_below_bound=pair(below),negative_above_bound=pair(above),negative_open_error_interval=[-negative,negative]))
assert (ES*F(7,10000)/6)<1
report=dict(status='PASS_DIRECTED_N0_AND_STRICT_OPEN_RNE_BOUNDS',parent_v2_FROZEN_sha256=hashlib.sha256((P/'FROZEN.json').read_bytes()).hexdigest(),inherited_v2_model_proof_sha256=hashlib.sha256((P/'model-proof.json').read_bytes()).hexdigest(),model_source_sha256=hashlib.sha256((W/'model.py').read_bytes()).hexdigest(),classes=classes,positive_n0_approximation_strictly_below_exp='All square/coefficient/products truncate downward and the positive degree6 Taylor remainder is strictly positive.',negative_error_identity='H - (Ptrue-Papprox) + positive alternating Taylor remainder; H>=0, all component underestimates bounded separately.',packed_guard='low byte is upper error B, high byte is total width A+B; one left normalization doubles both fields without byte carry',strict_guard_equivalence='Unsafe exactly when 0<((rounded_centre+B) mod2^S)<A+B; equality endpoints are safe because error bounds are strict.',integer_midpoints_and_open_endpoint_half_unit_evaluations=True,old_arithmetic_and_fixed_frames_unchanged=True,new_MPFR_or_ARM_calls=0,no_new_lookup_tables=True,hardware_accessed=False,integration_GO=False,goal_complete=False)
(W/'strict-bounds-proof.json').write_text(json.dumps(report,indent=2)+'\n');print(json.dumps(report,indent=2))
