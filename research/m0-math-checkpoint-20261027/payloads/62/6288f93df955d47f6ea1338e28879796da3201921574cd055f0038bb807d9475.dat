"""Integer reference for the cheaper Q73 operation; no producer runs on import."""
from pathlib import Path
import ast,hashlib,json,re
W=Path(__file__).resolve().parent;ROOT=W.parents[1]
S=ROOT/'.build/m0-math-unified-ddiv-power-dispatch-r48-20261026/source/code'
H=ROOT/'.build/m0-exp-q73-horner-host-study-20261026'
Q=1<<73;CAP=12912720851596686<<9;MASK=(1<<64)-1
t=(S/'native_eabi_m0_exp_table.inc').read_text()
STEP=(int(re.search(r'exp_step_high=UINT64_C\((\d+)\)',t)[1])<<32)|int(re.search(r'exp_step_low=(\d+)U',t)[1])
t=(S/'native_eabi_m0_refine_table.inc').read_text().split('refine_exp_table[512][3]={',1)[1].split('};',1)[0]
roots94=[a|(b<<32)|(c<<64)for a,b,c in [tuple(map(int,m))for m in re.findall(r'\{(\d+)U,(\d+)U,(\d+)U\}',t)]]
assert len(roots94)==512
roots73=[a>>21 for a in roots94]
assert hashlib.sha256((H/'model_horner.py').read_bytes()).hexdigest()=='c8e6f6f01acb6455666591f1b32a8048ab70cec5a537aea8412ae9c586f19f9a'
tree=ast.parse((H/'model_horner.py').read_text())
functions=ast.Module(body=[n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name in ('divide3_under','round_binary64')],type_ignores=[])
exec(compile(functions,str(H/'model_horner.py'),'exec'))
def multiply73(a,b):
    a0,a1,a2=a&65535,(a>>16)&65535,(a>>32)&65535
    b0,b1,b2=b&65535,(b>>16)&65535,(b>>32)&65535
    omitted=a0*b0+((a0*b1+a1*b0)<<16)+((a0*b2+a1*b1+a2*b0)<<32)
    return(a*b-omitted)>>73
def multiply52(a,b):
    a0,a1=a&65535,(a>>16)&65535;b0,b1=b&65535,(b>>16)&65535
    omitted=a0*b0+((a0*b1+a1*b0)<<16)
    return(a*b-omitted)>>52
def estimate_high32(a,b):
    return(a>>16)*(b>>16)+(((a&65535)*(b>>16)+(a>>16)*(b&65535))>>16)
def polynomial(r):
    mag=abs(r);c2=multiply73(mag,mag)
    linear=divide3_under(mag>>22);quartic=divide3_under(c2>>24)
    cubic=((((c2>>37)*(mag>>47))>>13)*4369)>>16
    tail=linear-quartic+cubic if r<0 else linear+quartic+cubic
    term=multiply52(c2,tail)
    return r+(c2>>1)+(-term if r<0 else term)
def evaluate(x):
    m=x&0x7fffffffffffffff
    if m>0x7ff0000000000000:
        return dict(kind='special',output=x|(1<<51))
    if not x>>63 and m>=0x40862e42fefa39f0:
        return dict(kind='special',output=0x7ff0000000000000)
    if x>>63 and m>=0x40874910d52d3052:
        return dict(kind='special',output=0)
    e=(m>>52)-1023
    if e< -21:return dict(kind='legacy-domain',output=None)
    sig=(m&((1<<52)-1))|(1<<52);n=0
    if e>=-11:n=((estimate_high32(sig>>21,0xb8aa3b29)>>(20-e))+1)>>1
    assert n<1<<20
    r=((sig<<(e+21))-((n*STEP)>>23))&MASK
    if r>>63:r-=1<<64
    if x>>63:r=-r
    assert abs(r)<=CAP
    delta=polynomial(r)
    nsigned=-n if x>>63 else n;index=nsigned&511;k=nsigned>>9;A=roots73[index]
    correction=multiply73(A,abs(delta))if index else abs(delta)
    q=A-correction if delta<0 else A+correction
    radius=3 if not index and e< -15 else 12 if not index else 24
    lo=round_binary64(q-radius,k-73);hi=round_binary64(q+radius,k-73)
    return dict(kind='accepted'if lo==hi else'ambiguous',output=lo if lo==hi else None,n=n,index=index,k=k,r73=r,delta73=delta,q73=q,radius=radius,lower_round=f'{lo:016X}',upper_round=f'{hi:016X}')
