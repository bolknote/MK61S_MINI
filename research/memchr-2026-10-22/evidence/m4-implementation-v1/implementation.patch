new file mode 100644
index 000000000..5a9b27a3c
--- /dev/null
+++ b/tests/run_system_memchr_arm_tests.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""Compile the actual memchr sources and check ARM bounds, early hits and ABI.
+
+These are functional Unicorn checks. Performance selection requires the
+separate hardware evidence in research/memchr-2026-10-22.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+from check_stm32_vectors import ElfImage
+import system_memchr_arm_self_test as spans
+import system_memchr_guard_self_test as guards
+
+ROOT=Path(__file__).resolve().parents[1]
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--arm-toolchain-bin',type=Path,required=True)
+    p.add_argument('--output',type=Path,required=True)
+    a=p.parse_args();out=a.output.resolve();out.mkdir(parents=True,exist_ok=False)
+    cases=[
+        ('native-f411','m4','code/system_strings.c',['-DMK61_NATIVE_RUNTIME=1'],0x08010000,450),
+        ('native-f401','m4','code/system_strings.c',['-DMK61_NATIVE_RUNTIME=1','-DSTM32F401xC'],0x08018000,270),
+        ('sdk-normal','m4','sdk/portable/memory.c',[],0x20010000,450),
+        ('sdk-shared','m4','sdk/portable/memory.c',['-DMK61_APP_SHARED_RUNTIME=1'],0x20018000,450),
+        ('sdk-langin','m4','sdk/portable/memory.c',['-DMK61_APP_SHARED_RUNTIME=1','-DMK61_MEMCHR_WORDS=4'],0x20020000,270),
+        ('sdk-m0-unchanged','m0','sdk/portable/memory.c',[],0x20010000,26),
+    ]
+    hashes={450:'bd4502b3460e1d7c13ffdfe257d0106099e36111433ba9b0e1565cc5172de521',
+            270:'e5ce46b95e76623993455cd0ad24c51ca1d4a0e5a1bfcab2fbf7634db3c98a78'}
+    seen={};results=[]
+    for name,cpu,source,defines,address,expected_size in cases:
+        folder=out/name;folder.mkdir()
+        arch=['-mcpu='+('cortex-m4' if cpu=='m4' else 'cortex-m0plus'),'-mthumb']
+        if cpu=='m4':arch+=['-mfpu=fpv4-sp-d16','-mfloat-abi=hard']
+        common=[str(a.arm_toolchain_bin/'arm-none-eabi-gcc'),*arch]
+        command=common+['-Os','-fno-builtin','-fno-lto','-ffunction-sections','-fdata-sections',
+            '-Wall','-Wextra','-Werror','-I'+str(ROOT/'code'),*defines,'-c',str(ROOT/source),'-o',str(folder/'body.o')]
+        subprocess.run(command,check=True)
+        subprocess.run(common+['-nostdlib','-Wl,--gc-sections,-Ttext='+hex(address)+',-e,memchr',
+            str(folder/'body.o'),'-o',str(folder/'body.elf')],check=True)
+        elf=ElfImage(folder/'body.elf');section=elf.named_sections['.text'];raw=elf.bytes_at(section)
+        size=elf.sizes['memchr'];start=(elf.symbols['memchr']&~1)-section[3]
+        digest=hashlib.sha256(raw[start:start+size]).hexdigest()
+        assert size==expected_size,(name,size,expected_size)
+        expected_hash = hashes[size] if cpu=='m4' else 'b0e7e8be7f9f6ce95ec7d9c86f2996103968641c0a917b3fe7fd8687994e0acf'
+        assert digest==expected_hash,(name,digest,'measured or retained body changed')
+        row=dict(name=name,cpu=cpu,bytes=size,body_sha256=digest,command=command)
+        # Shared SDK exports the same local body while the public optional
+        # runtime extension is pending. Verify identity without repeating it.
+        key=(cpu,digest,address>>28)
+        if key in seen:
+            row.update(status='PASS',same_code_and_placement_as=seen[key])
+        else:
+            span=spans.verify(folder/'body.elf',cpu,['memchr'])
+            (folder/'span.json').write_text(json.dumps(span,indent=2)+'\n')
+            boundaries=[]
+            for boundary in (0x20080000,0x2007ffe0,0x2007ff00):
+                result=guards.verify(folder/'body.elf',cpu,['memchr'],guard=boundary)
+                assert result['status']=='PASS',(name,boundary,result)
+                boundaries.append(result)
+            (folder/'guards.json').write_text(json.dumps(boundaries,indent=2)+'\n')
+            row.update(status='PASS',span_cases=span['results'][0]['cases'],
+                       guard_cases=sum(x['results'][0]['cases'] for x in boundaries))
+            seen[key]=name
+        results.append(row)
+    report=dict(status='PASS',scope='Actual source ARM functional regression, not timing',results=results,
+        M0_performance_selection=False,optional_public_runtime_extension=False)
+    (out/'result.json').write_text(json.dumps(report,indent=2)+'\n')
+    print(json.dumps(dict(status='PASS',linked_bodies=len(results),functional_calls=sum(r.get('span_cases',0)+r.get('guard_cases',0) for r in results))))
+
+
+if __name__=='__main__':main()
diff --git a/tests/system_memchr_arm_self_test.py b/tests/system_memchr_arm_self_test.py
new file mode 100644
index 000000000..daf498a63
--- /dev/null
+++ b/tests/system_memchr_arm_self_test.py
@@ -0,0 +1,109 @@
+#!/usr/bin/env python3
+"""Execute memchr ARM code: earliest unsigned-byte match, exact bounds, ABI."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import random
+import struct
+from check_stm32_vectors import ElfImage
+from unicorn import Uc, UC_ARCH_ARM, UC_MODE_THUMB, UC_MODE_MCLASS, UC_HOOK_MEM_READ, UC_HOOK_MEM_WRITE, UC_MEM_WRITE
+from unicorn.arm_const import (UC_CPU_ARM_CORTEX_M0, UC_CPU_ARM_CORTEX_M4,
+    UC_ARM_REG_R0, UC_ARM_REG_R1, UC_ARM_REG_R2, UC_ARM_REG_R4, UC_ARM_REG_R11,
+    UC_ARM_REG_SP, UC_ARM_REG_LR, UC_ARM_REG_PC, UC_ARM_REG_XPSR)
+
+def verify(elf,cpu,names,input_address=0x20040000,indirect_target=None):
+    image=ElfImage(elf)
+    def function_size(name):
+        if image.sizes[name]:return image.sizes[name]
+        start=image.symbols[name]&~1
+        if name+'_end' in image.symbols:return (image.symbols[name+'_end']&~1)-start
+        section=next(s for s in image.sections if s[2]&4 and s[3]<=start<s[3]+s[5])
+        end=min([s&~1 for n,s in image.symbols.items() if image.sizes[n] and start<(s&~1)<section[3]+section[5]]+[section[3]+section[5]])
+        return end-start
+    sizes_by_name={n:function_size(n) for n in names}
+    machine=Uc(UC_ARCH_ARM,UC_MODE_THUMB|UC_MODE_MCLASS)
+    machine.ctl_set_cpu_model(UC_CPU_ARM_CORTEX_M0 if cpu=='m0' else UC_CPU_ARM_CORTEX_M4)
+    for address,size in ((0x20000000,0x100000),(0x08000000,0x100000),(0x10000000,0x200000),(0x30000000,4096)):
+        machine.mem_map(address,size)
+    image.load(machine)
+    stop,stack,buffer=0x30000000,0x200fe000,input_address
+    indirect_reads=[]
+    if indirect_target:
+        table=0x200f0000;global_pointer=image.symbols['bench_search_runtime']
+        machine.mem_write(global_pointer,struct.pack('<I',table))
+        machine.mem_write(table+104,struct.pack('<I',image.symbols[indirect_target]|1))
+        target=image.symbols[indirect_target]&~1
+        indirect_reads=[(global_pointer,global_pointer+4),(table,table+108),(target,target+function_size(indirect_target))]
+    sizes=[*range(130),255,256,257,511,512,513,1023,1024,1025,4095,4096,4097,16384,65536]
+    cases=[]
+    for n in sizes:
+        positions=range(n) if n<=16 else sorted({0,1,2,3,4,7,8,15,16,n//2,n-1})
+        for offset in range(8):
+            for value in (0,1,127,128,255):
+                cases.append((n,offset,value,-1,False))
+                for at in positions:cases.append((n,offset,value,at,True))
+    for value in [*range(256),-513,-1,256,511,0x123400A5]:
+        for offset in range(4):
+            for at in (-1,0,1,2,3,4,7,8,15,16,31,32,63):
+                cases.append((64,offset,value,at,True))
+    rng=random.Random(610422)
+    for _ in range(500):
+        n=rng.randrange(8193)
+        cases.append((n,rng.randrange(16),rng.randrange(-1024,1024),rng.randrange(n) if n else -1,False))
+    saved={reg:0x72816201+reg*314 for reg in range(UC_ARM_REG_R4,UC_ARM_REG_R11+1)}
+    active={}
+    def access(_machine,kind,address,size,_value,_user):
+        if cpu=='m0':assert size in (1,2,4) and address%size==0,('alignment',hex(address),size,active)
+        on_stack=stack-64<=address and address+size<=stack
+        if kind==UC_MEM_WRITE:
+            assert on_stack,('memchr wrote outside stack',hex(address),size,active)
+        else:
+            assert on_stack or any(a<=address and address+size<=b for a,b in active['read']),('read beyond input span',hex(address),size,active)
+    machine.hook_add(UC_HOOK_MEM_READ|UC_HOOK_MEM_WRITE,access)
+    def call(name,pointer,value,n,expected):
+        start=image.symbols[name]&~1
+        active.update(name=name,n=n,value=value,pointer=pointer,
+            read=[(pointer,pointer+n),(start,start+sizes_by_name[name])]+(indirect_reads if name=='indirect_search' else []))
+        for reg,initial in saved.items():machine.reg_write(reg,initial)
+        for reg,initial in ((UC_ARM_REG_R0,pointer),(UC_ARM_REG_R1,value&0xffffffff),(UC_ARM_REG_R2,n),
+                (UC_ARM_REG_SP,stack),(UC_ARM_REG_LR,stop|1),(UC_ARM_REG_XPSR,0x01000000)):
+            machine.reg_write(reg,initial)
+        try:machine.emu_start(start|1,stop,count=1500000)
+        except Exception:
+            print('FAIL',active,hex(machine.reg_read(UC_ARM_REG_PC)),flush=True)
+            raise
+        assert machine.reg_read(UC_ARM_REG_PC)==stop,(active,'return')
+        assert machine.reg_read(UC_ARM_REG_R0)==expected,(active,'result',hex(machine.reg_read(UC_ARM_REG_R0)),hex(expected))
+        assert machine.reg_read(UC_ARM_REG_SP)==stack,(active,'stack')
+        assert all(machine.reg_read(reg)==initial for reg,initial in saved.items()),(active,'callee saved')
+    results=[]
