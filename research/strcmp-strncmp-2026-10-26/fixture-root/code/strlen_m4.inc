/* Exact measured 132-byte DSP32 body; preserve entry alignment and pool. */
".syntax unified\n"
"mov r1,r0\n"
"1:\n"
"ldrb r2,[r0]\n"
"cmp r2,#0\n"
"beq 7f\n"
"lsls r3,r0,#29\n"
"beq 2f\n"
"adds r0,#1\n"
"b 1b\n"
"2:\n"
"push {r4,r5}\n"
"ldr r4,8f\n"
"3:\n"
".rept 4\n"
"ldrd r2,r3,[r0],#8\n"
"uqsub8 r5,r4,r2\n"
"uqsub8 r12,r4,r3\n"
"orrs r12,r12,r5\n"
"bne 4f\n"
".endr\n"
"b 3b\n"
"4:\n"
"subs r0,#8\n"
"cmp r5,#0\n"
"bne 5f\n"
"adds r0,#4\n"
"mov r5,r12\n"
"5:\n"
"rbit r5,r5\n"
"clz r5,r5\n"
"lsrs r5,#3\n"
"adds r0,r0,r5\n"
"subs r0,r0,r1\n"
"pop {r4,r5}\n"
"bx lr\n"
"7:\n"
"subs r0,r0,r1\n"
"bx lr\n"
".p2align 2\n"
"8:\n"
".word 0x01010101\n"
