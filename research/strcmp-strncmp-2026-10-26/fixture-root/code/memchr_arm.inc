/* Measured M4 balanced / M0+ pair candidates; exact spans only. */
".syntax unified\n"
".macro mk61_search_pair name,bulk=0\n"
" ldmia r0!,{r3,r6}\n"
#if defined(__ARM_ARCH_6M__)
" eors r3,r1\n"
" movs r7,r3\n"
" subs r7,r4\n"
" bics r7,r3\n"
" tst r7,r5\n"
" bne .Lfirst\\name\n"
" eors r6,r1\n"
" movs r7,r6\n"
" subs r7,r4\n"
" bics r7,r6\n"
" tst r7,r5\n"
" bne .Lsecond\\name\n"
#else
" eor r3,r3,r1\n"
" eor r6,r6,r1\n"
" usub8 r3,r3,r4\n"
" sel r3,r5,r4\n"
" usub8 r6,r6,r4\n"
" /* If word two has no match in a lane, retain word one's mask. */\n"
" sel r6,r3,r4\n"
#if 0
" .if \\bulk\n"
" cbnz r6,.LpairHit\\name\n"
" .else\n"
" cmp r6,#0\n"
" bne .LpairHit\\name\n"
" .endif\n"
#else
" cmp r6,#0\n"
" bne .LpairHit\\name\n"
#endif
#endif
".endm\n"
".macro mk61_search_body name,pairs\n"
" cmp r2,#0\n"
" beq .Lzero\\name\n"
" uxtb r1,r1\n"
" ldrb r3,[r0]\n"
" cmp r3,r1\n"
" beq .Lreturn\\name\n"
#if !defined(__ARM_ARCH_6M__)
" /* Keep the original pointer/alignment for long spans, but exhaust n==1\n"
"  * before the length dispatch. Restore n only on the long path. */\n"
" subs r2,#1\n"
" beq .Lzero\\name\n"
" cmp r2,#7\n"
" bhs .LalignCheck\\name\n"
" adds r0,#1\n"
#elif 0
" /* Consume the checked byte before dispatch: n==1 returns immediately. */\n"
" subs r2,#1\n"
" beq .Lzero\\name\n"
" adds r0,#1\n"
" cmp r2,#7\n"
" bhs .Lprefix\\name\n"
#else
" cmp r2,#8\n"
" bhs .LalignCheck\\name\n"
" adds r0,#1\n"
" subs r2,#1\n"
" beq .Lzero\\name\n"
#endif
".Lsmall\\name:\n"
" ldrb r3,[r0]\n"
" cmp r3,r1\n"
" beq .Lreturn\\name\n"
" adds r0,#1\n"
" subs r2,#1\n"
" bne .Lsmall\\name\n"
".Lzero\\name:\n"
" movs r0,#0\n"
".Lreturn\\name:\n"
" bx lr\n"
".LalignCheck\\name:\n"
#if !defined(__ARM_ARCH_6M__)
" adds r2,#1\n"
#endif
" lsls r3,r0,#29\n"
" beq .Laligned\\name\n"
" adds r0,#1\n"
" subs r2,#1\n"
".Lprefix\\name:\n"
" lsls r3,r0,#29\n"
" beq .Laligned\\name\n"
" ldrb r3,[r0]\n"
" cmp r3,r1\n"
" beq .Lreturn\\name\n"
" adds r0,#1\n"
" subs r2,#1\n"
" b .Lprefix\\name\n"
".Laligned\\name:\n"
#if defined(__ARM_ARCH_6M__)
" push {r4,r5,r6,r7}\n"
#else
" push {r4,r5,r6}\n"
#endif
" ldr r4,=0x01010101\n"
#if defined(__ARM_ARCH_6M__)
" lsls r5,r4,#7\n"
" muls r1,r4\n"
#else
" movs r5,#0\n"
" mul r1,r1,r4\n"
#endif
" .if \\pairs>1\n"
" cmp r2,#(8*\\pairs)\n"
" bhs .Lbulk\\name\n"
" b .LpairCheck\\name\n"
".Lbulk\\name:\n"
" .rept \\pairs\n"
" mk61_search_pair \\name,1\n"
" .endr\n"
" b .LbulkNext\\name\n"
" .endif\n"
#if defined(__ARM_ARCH_6M__)
".Lfirst\\name:\n"
" subs r0,#8\n"
" b .Lfound\\name\n"
".Lsecond\\name:\n"
" subs r0,#4\n"
" b .Lfound\\name\n"
#else
".LpairHit\\name:\n"
" cmp r3,#0\n"
" bne .Lfirst\\name\n"
" mov r3,r6\n"
" subs r0,#4\n"
" b .Lfound\\name\n"
".Lfirst\\name:\n"
" subs r0,#8\n"
" b .Lfound\\name\n"
#endif
" .if \\pairs>1\n"
".LbulkNext\\name:\n"
" subs r2,#(8*\\pairs)\n"
" cmp r2,#(8*\\pairs)\n"
" blo .LpairCheck\\name\n"
" b .Lbulk\\name\n"
" .endif\n"
".LpairCheck\\name:\n"
" cmp r2,#8\n"
" blo .LwordCheck\\name\n"
".Lpair\\name:\n"
" mk61_search_pair \\name\n"
" subs r2,#8\n"
" cmp r2,#8\n"
" bhs .Lpair\\name\n"
".LwordCheck\\name:\n"
" cmp r2,#4\n"
" blo .LtailCheck\\name\n"
" ldr r3,[r0]\n"
#if defined(__ARM_ARCH_6M__)
" eors r3,r1\n"
" movs r7,r3\n"
" subs r7,r4\n"
" bics r7,r3\n"
" tst r7,r5\n"
#else
" eor r3,r3,r1\n"
" usub8 r3,r3,r4\n"
" sel r3,r5,r4\n"
" cmp r3,#0\n"
#endif
" bne .Lfound\\name\n"
" adds r0,#4\n"
" subs r2,#4\n"
".LtailCheck\\name:\n"
" cmp r2,#0\n"
" beq .LsavedZero\\name\n"
" uxtb r1,r1\n"
".Ltail\\name:\n"
" ldrb r3,[r0]\n"
" cmp r3,r1\n"
" beq .LsavedReturn\\name\n"
" adds r0,#1\n"
" subs r2,#1\n"
" bne .Ltail\\name\n"
".LsavedZero\\name:\n"
" movs r0,#0\n"
".LsavedReturn\\name:\n"
#if defined(__ARM_ARCH_6M__)
" pop {r4,r5,r6,r7}\n"
#else
" pop {r4,r5,r6}\n"
#endif
" bx lr\n"
".Lfound\\name:\n"
#if defined(__ARM_ARCH_6M__)
" uxtb r1,r1\n"
".LfindByte\\name:\n"
" ldrb r3,[r0]\n"
" cmp r3,r1\n"
" beq .LsavedReturn\\name\n"
" adds r0,#1\n"
" b .LfindByte\\name\n"
#else
" rbit r3,r3\n"
" clz r3,r3\n"
" add r0,r0,r3,lsr#3\n"
" b .LsavedReturn\\name\n"
#endif
" .ltorg\n"
".endm\n"
".altmacro\n"
"mk61_search_body mk61," MK61_MEMCHR_STRINGIFY(MK61_MEMCHR_WORDS) "/2\n"
".noaltmacro\n"
".purgem mk61_search_pair\n"
".purgem mk61_search_body\n"
".syntax divided\n"
