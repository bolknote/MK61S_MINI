/* Directional, bounded memmove. Preserve every unread source byte.
 * Source and destination may overlap by any number of bytes.
 * Exported by research/memmove-2026-10-21/export.py from the measured candidate.
 * M0+: aligned LDM/STM, bounded shift/merge for unequal alignment.
 * M4: aligned LDM/LDMDB, ordinary stores, exact prefix and tail accesses. */
" .syntax unified\n"
".cpu cortex-m0plus\n"
".macro mk61_move_merge tag,k,back\n"
".Lmk61_memmove_merge\\tag\\@:\n"
" movs r5,#0\n"
" .if \\back\n"
" subs r1,#\\k\n"
" .if \\k==3\n"
" ldrb r5,[r1,#2]\n"
" lsls r5,r5,#8\n"
" .endif\n"
" .if \\k>=2\n"
" ldrb r3,[r1,#1]\n"
" orrs r5,r3\n"
" lsls r5,r5,#8\n"
" .endif\n"
" ldrb r3,[r1]\n"
" orrs r5,r3\n"
" lsls r5,r5,#(32-\\k*8)\n"
" .else\n"
" .if \\k==3\n"
" ldrb r5,[r1,#2]\n"
" lsls r5,r5,#8\n"
" .endif\n"
" .if \\k>=2\n"
" ldrb r3,[r1,#1]\n"
" orrs r5,r3\n"
" lsls r5,r5,#8\n"
" .endif\n"
" ldrb r3,[r1]\n"
" orrs r5,r3\n"
" adds r1,#\\k\n"
" .endif\n"
" subs r2,#(4+\\k)\n"
" cmp r2,#12\n"
" blo .Lmk61_memmove_mword\\@\n"
" subs r2,#12\n"
".Lmk61_memmove_m16\\@:\n"
" .rept 4\n"
" .if \\back\n"
" subs r1,#4\n"
" ldr r3,[r1]\n"
" lsrs r4,r3,#(\\k*8)\n"
" orrs r4,r5\n"
" subs r0,#4\n"
" str r4,[r0]\n"
" lsls r5,r3,#(32-\\k*8)\n"
" .else\n"
" ldmia r1!,{r3}\n"
" lsls r4,r3,#(\\k*8)\n"
" orrs r4,r5\n"
" stmia r0!,{r4}\n"
" lsrs r5,r3,#(32-\\k*8)\n"
" .endif\n"
" .endr\n"
" subs r2,#16\n"
" bhs .Lmk61_memmove_m16\\@\n"
" adds r2,#12\n"
" bcc .Lmk61_memmove_mend\\@\n"
".Lmk61_memmove_mword\\@:\n"
" .if \\back\n"
" subs r1,#4\n"
" ldr r3,[r1]\n"
" lsrs r4,r3,#(\\k*8)\n"
" orrs r4,r5\n"
" subs r0,#4\n"
" str r4,[r0]\n"
" lsls r5,r3,#(32-\\k*8)\n"
" .else\n"
" ldmia r1!,{r3}\n"
" lsls r4,r3,#(\\k*8)\n"
" orrs r4,r5\n"
" stmia r0!,{r4}\n"
" lsrs r5,r3,#(32-\\k*8)\n"
" .endif\n"
" subs r2,#4\n"
" bhs .Lmk61_memmove_mword\\@\n"
".Lmk61_memmove_mend\\@:\n"
" .rept \\k\n"
" .if \\back\n"
" lsrs r3,r5,#24\n"
" subs r0,#1\n"
" strb r3,[r0]\n"
" lsls r5,r5,#8\n"
" .else\n"
" strb r5,[r0]\n"
" adds r0,#1\n"
" lsrs r5,r5,#8\n"
" .endif\n"
" .endr\n"
" adds r2,#4\n"
" pop {r4,r5,r6}\n"
" b .Lmk61_memmove_bytes\\tag\n"
".endm\n"
".macro mk61_move_directional name,tag,back,unroll\n"
" .if \\back && !\\unroll\n"
" adds r0,r0,r2\n"
" adds r1,r1,r2\n"
" .endif\n"
" cmp r2,#8\n"
" .if !\\back && \\unroll\n"
" blo .Lmk61_memmove_byteFast\\tag\n"
" .elseif \\back && \\unroll\n"
" blo .Lmk61_memmove_byteStart\\tag\n"
" .else\n"
" blo .Lmk61_memmove_bytes\\tag\n"
" .endif\n"
" movs r3,r0\n"
" eors r3,r1\n"
" lsls r3,r3,#30\n"
" bne .Lmk61_memmove_mismatch\\tag\n"
" push {r4,r5,r6}\n"
" .if \\back && \\unroll\n"
" adds r0,r0,r2\n"
" adds r1,r1,r2\n"
" .endif\n"
" lsls r3,r0,#31\n"
" bpl .Lmk61_memmove_alignHalf\\tag\n"
" .if \\back\n"
" subs r0,#1\n"
" subs r1,#1\n"
" .endif\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
" .if !\\back\n"
" adds r0,#1\n"
" adds r1,#1\n"
" .endif\n"
" subs r2,#1\n"
".Lmk61_memmove_alignHalf\\tag:\n"
" lsls r3,r0,#30\n"
" bpl .Lmk61_memmove_words\\tag\n"
" .if \\back\n"
" subs r0,#2\n"
" subs r1,#2\n"
" .endif\n"
" ldrh r3,[r1]\n"
" strh r3,[r0]\n"
" .if !\\back\n"
" adds r0,#2\n"
" adds r1,#2\n"
" .endif\n"
" subs r2,#2\n"
" b .Lmk61_memmove_words\\tag\n"
".Lmk61_memmove_mismatch\\tag:\n"
" cmp r2,#24\n"
" .if !\\back && \\unroll\n"
" blo .Lmk61_memmove_byteFast\\tag\n"
" .elseif \\back && \\unroll\n"
" blo .Lmk61_memmove_byteStart\\tag\n"
" .else\n"
" blo .Lmk61_memmove_bytes\\tag\n"
" .endif\n"
" push {r4,r5,r6}\n"
" .if \\back && \\unroll\n"
" adds r0,r0,r2\n"
" adds r1,r1,r2\n"
" .endif\n"
" movs r4,#3\n"
".Lmk61_memmove_align\\tag:\n"
" tst r0,r4\n"
" beq .Lmk61_memmove_aligned\\tag\n"
" .if \\back\n"
" subs r0,#1\n"
" subs r1,#1\n"
" .endif\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
" .if !\\back\n"
" adds r0,#1\n"
" adds r1,#1\n"
" .endif\n"
" subs r2,#1\n"
" b .Lmk61_memmove_align\\tag\n"
".Lmk61_memmove_aligned\\tag:\n"
" movs r3,r1\n"
" ands r3,r4\n"
" .if \\back\n"
" cmp r3,#3\n"
" .else\n"
" cmp r3,#1\n"
" .endif\n"
" bne .Lmk61_memmove_not3\\tag\n"
" b .Lmk61_memmove_case3\\tag\n"
".Lmk61_memmove_not3\\tag:\n"
" cmp r3,#2\n"
" bne .Lmk61_memmove_not2\\tag\n"
" b .Lmk61_memmove_case2\\tag\n"
".Lmk61_memmove_not2\\tag:\n"
" b .Lmk61_memmove_case1\\tag\n"
".Lmk61_memmove_words\\tag:\n"
" subs r2,#16\n"
" blo .Lmk61_memmove_tail\\tag\n"
" .if \\unroll\n"
" cmp r2,#48\n"
" blo .Lmk61_memmove_16\\tag\n"
" subs r2,#48\n"
".Lmk61_memmove_64\\tag:\n"
" .rept 4\n"
" .if \\back\n"
" subs r1,#16\n"
" ldmia r1!,{r3,r4,r5,r6}\n"
" subs r1,#16\n"
" subs r0,#16\n"
" stmia r0!,{r3,r4,r5,r6}\n"
" subs r0,#16\n"
" .else\n"
" ldmia r1!,{r3,r4,r5,r6}\n"
" stmia r0!,{r3,r4,r5,r6}\n"
" .endif\n"
" .endr\n"
" subs r2,#64\n"
" bhs .Lmk61_memmove_64\\tag\n"
" adds r2,#48\n"
" bcc .Lmk61_memmove_tail\\tag\n"
" .endif\n"
".Lmk61_memmove_16\\tag:\n"
" .if \\back\n"
" subs r1,#16\n"
" ldmia r1!,{r3,r4,r5,r6}\n"
" subs r1,#16\n"
" subs r0,#16\n"
" stmia r0!,{r3,r4,r5,r6}\n"
" subs r0,#16\n"
" .else\n"
" ldmia r1!,{r3,r4,r5,r6}\n"
" stmia r0!,{r3,r4,r5,r6}\n"
" .endif\n"
" subs r2,#16\n"
" bhs .Lmk61_memmove_16\\tag\n"
".Lmk61_memmove_tail\\tag:\n"
" adds r2,#16\n"
" cmp r2,#4\n"
" blo .Lmk61_memmove_pop\\tag\n"
".Lmk61_memmove_word\\tag:\n"
" .if \\back\n"
" subs r1,#4\n"
" ldr r3,[r1]\n"
" subs r0,#4\n"
" str r3,[r0]\n"
" .else\n"
" ldmia r1!,{r3}\n"
" stmia r0!,{r3}\n"
" .endif\n"
" subs r2,#4\n"
" cmp r2,#4\n"
" bhs .Lmk61_memmove_word\\tag\n"
".Lmk61_memmove_pop\\tag:\n"
" pop {r4,r5,r6}\n"
".Lmk61_memmove_bytes\\tag:\n"
" cmp r2,#0\n"
" beq .Lmk61_memmove_return\\tag\n"
" .if \\back && \\unroll\n"
" /* Indexing from the remaining span's start saves two pointer decrements.\n"
"  * LDRB/STRB preserve the flags from SUBS, so no extra CMP is necessary. */\n"
" subs r0,r0,r2\n"
" subs r1,r1,r2\n"
".Lmk61_memmove_byteStart\\tag:\n"
".Lmk61_memmove_byte\\tag:\n"
" subs r2,#1\n"
" ldrb r3,[r1,r2]\n"
" strb r3,[r0,r2]\n"
" bne .Lmk61_memmove_byte\\tag\n"
" .else\n"
".Lmk61_memmove_byte\\tag:\n"
" .if \\back\n"
" subs r0,#1\n"
" subs r1,#1\n"
" .endif\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
" .if !\\back\n"
" adds r0,#1\n"
" adds r1,#1\n"
" .endif\n"
" subs r2,#1\n"
" bne .Lmk61_memmove_byte\\tag\n"
" .endif\n"
".Lmk61_memmove_return\\tag:\n"
" mov r0,r12\n"
" bx lr\n"
" .if !\\back && \\unroll\n"
" /* Only enter for complete small spans (n > 4), keeping the ordinary\n"
"  * 0..3-byte word-loop tails free of the four-byte loop setup. */\n"
".Lmk61_memmove_byteFast\\tag:\n"
" subs r2,#4\n"
".Lmk61_memmove_byteFour\\tag:\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
" ldrb r3,[r1,#1]\n"
" strb r3,[r0,#1]\n"
" ldrb r3,[r1,#2]\n"
" strb r3,[r0,#2]\n"
" ldrb r3,[r1,#3]\n"
" strb r3,[r0,#3]\n"
" adds r1,#4\n"
" adds r0,#4\n"
" subs r2,#4\n"
" bhs .Lmk61_memmove_byteFour\\tag\n"
" adds r2,#4\n"
" b .Lmk61_memmove_bytes\\tag\n"
" .endif\n"
".Lmk61_memmove_case3\\tag:\n"
" mk61_move_merge \\tag,3,\\back\n"
".Lmk61_memmove_case2\\tag:\n"
" mk61_move_merge \\tag,2,\\back\n"
".Lmk61_memmove_case1\\tag:\n"
" mk61_move_merge \\tag,1,\\back\n"
".endm\n"
".macro mk61_move_move name,unroll\n"
" cmp r2,#0\n"
" beq .Lmk61_memmove_noop\\name\n"
" cmp r0,r1\n"
" bne .Lmk61_memmove_nonzero\\name\n"
".Lmk61_memmove_noop\\name:\n"
" bx lr\n"
".Lmk61_memmove_nonzero\\name:\n"
" .if \\unroll\n"
" cmp r2,#4\n"
" bhi .Lmk61_memmove_start\\name\n"
" cmp r2,#1\n"
" beq .Lmk61_memmove_one\\name\n"
" cmp r2,#2\n"
" beq .Lmk61_memmove_two\\name\n"
" cmp r2,#3\n"
" beq .Lmk61_memmove_three\\name\n"
" push {r4}\n"
" ldrb r3,[r1]\n"
" ldrb r2,[r1,#1]\n"
" ldrb r4,[r1,#2]\n"
" ldrb r1,[r1,#3]\n"
" strb r3,[r0]\n"
" strb r2,[r0,#1]\n"
" strb r4,[r0,#2]\n"
" strb r1,[r0,#3]\n"
" pop {r4}\n"
" bx lr\n"
".Lmk61_memmove_three\\name:\n"
" ldrb r3,[r1]\n"
" ldrb r2,[r1,#1]\n"
" ldrb r1,[r1,#2]\n"
" strb r3,[r0]\n"
" strb r2,[r0,#1]\n"
" strb r1,[r0,#2]\n"
" bx lr\n"
".Lmk61_memmove_two\\name:\n"
" ldrb r3,[r1]\n"
" ldrb r1,[r1,#1]\n"
" strb r3,[r0]\n"
" strb r1,[r0,#1]\n"
" bx lr\n"
".Lmk61_memmove_one\\name:\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
" bx lr\n"
" .endif\n"
".Lmk61_memmove_start\\name:\n"
" mov r12,r0\n"
" cmp r0,r1\n"
" blo .Lmk61_memmove_forward\\name\n"
" .if \\unroll\n"
" /* Disjoint spans can use the cheaper forward loop (including Flash input). */\n"
" subs r3,r0,r1\n"
" cmp r3,r2\n"
" bhs .Lmk61_memmove_forward\\name\n"
" .endif\n"
" b .Lmk61_memmove_backward\\name\n"
".Lmk61_memmove_forward\\name:\n"
" mk61_move_directional \\name,f\\name,0,\\unroll\n"
".Lmk61_memmove_backward\\name:\n"
" mk61_move_directional \\name,b\\name,1,\\unroll\n"
".endm\n"
"\n"
"mk61_move_move body,1\n"
".purgem mk61_move_move\n"
".purgem mk61_move_directional\n"
".purgem mk61_move_merge\n"
