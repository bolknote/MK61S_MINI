/* Directional, bounded memmove. Preserve every unread source byte.
 * Source and destination may overlap by any number of bytes.
 * Exported by research/memmove-2026-10-21/export.py from the measured candidate.
 * M0+: aligned LDM/STM, bounded shift/merge for unequal alignment.
 * M4: aligned LDM/LDMDB, ordinary stores, exact prefix and tail accesses. */
" .syntax unified\n"
"\n"
".macro mk61_move_block back\n"
" .if \\back\n"
" ldmdb r1!,{r3,r4,r5,r6}\n"
" subs r0,#16\n"
" .else\n"
" ldmia r1!,{r3,r4,r5,r6}\n"
" .endif\n"
" str r3,[r0]\n"
" str r4,[r0,#4]\n"
" str r5,[r0,#8]\n"
" str r6,[r0,#12]\n"
" .if !\\back\n"
" adds r0,#16\n"
" .endif\n"
".endm\n"
".macro mk61_move_directional name,tag,back,unroll\n"
" .if \\back\n"
" add r0,r2\n"
" add r1,r2\n"
" .endif\n"
" tst r1,#1\n"
" beq .Lmk61_memmove_half\\tag\n"
" .if \\back\n"
" ldrb r3,[r1,#-1]!\n"
" strb r3,[r0,#-1]!\n"
" .else\n"
" ldrb r3,[r1],#1\n"
" strb r3,[r0],#1\n"
" .endif\n"
" subs r2,#1\n"
".Lmk61_memmove_half\\tag:\n"
" tst r1,#2\n"
" beq .Lmk61_memmove_bulk\\tag\n"
" .if \\back\n"
" ldrh r3,[r1,#-2]!\n"
" strh r3,[r0,#-2]!\n"
" .else\n"
" ldrh r3,[r1],#2\n"
" strh r3,[r0],#2\n"
" .endif\n"
" subs r2,#2\n"
".Lmk61_memmove_bulk\\tag:\n"
" .if \\unroll\n"
" subs r2,#64\n"
" blo .Lmk61_memmove_fix16\\tag\n"
".Lmk61_memmove_64\\tag:\n"
" .rept 4\n"
" mk61_move_block \\back\n"
" .endr\n"
" subs r2,#64\n"
" bhs .Lmk61_memmove_64\\tag\n"
".Lmk61_memmove_fix16\\tag:\n"
" adds r2,#48\n"
" blo .Lmk61_memmove_tail\\tag\n"
" .else\n"
" subs r2,#16\n"
" blo .Lmk61_memmove_tail\\tag\n"
" .endif\n"
".Lmk61_memmove_16\\tag:\n"
" mk61_move_block \\back\n"
" subs r2,#16\n"
" bhs .Lmk61_memmove_16\\tag\n"
".Lmk61_memmove_tail\\tag:\n"
" adds r2,#16\n"
" pop {r4,r5,r6}\n"
" cmp r2,#4\n"
" blo .Lmk61_memmove_bytes\\tag\n"
".Lmk61_memmove_word\\tag:\n"
" .if \\back\n"
" ldr r3,[r1,#-4]!\n"
" str r3,[r0,#-4]!\n"
" .else\n"
" ldr r3,[r1],#4\n"
" str r3,[r0],#4\n"
" .endif\n"
" subs r2,#4\n"
" cmp r2,#4\n"
" bhs .Lmk61_memmove_word\\tag\n"
".Lmk61_memmove_bytes\\tag:\n"
" cbz r2,.Lmk61_memmove_return\\tag\n"
".Lmk61_memmove_byte\\tag:\n"
" .if \\back\n"
" ldrb r3,[r1,#-1]!\n"
" strb r3,[r0,#-1]!\n"
" .else\n"
" ldrb r3,[r1],#1\n"
" strb r3,[r0],#1\n"
" .endif\n"
" subs r2,#1\n"
" bne .Lmk61_memmove_byte\\tag\n"
".Lmk61_memmove_return\\tag:\n"
" mov r0,r12\n"
" bx lr\n"
".endm\n"
".macro mk61_move_move name,unroll\n"
" cbz r2,.Lmk61_memmove_noop\\name\n"
" cmp r0,r1\n"
" beq .Lmk61_memmove_noop\\name\n"
" cmp r2,#4\n"
" blo .Lmk61_memmove_tiny\\name\n"
" cmp r2,#8\n"
" bhi .Lmk61_memmove_medium\\name\n"
" ldr r3,[r1]\n"
" subs r2,#4\n"
" ldr r1,[r1,r2]\n"
" str r3,[r0]\n"
" str r1,[r0,r2]\n"
" bx lr\n"
".Lmk61_memmove_tiny\\name:\n"
" cmp r2,#1\n"
" beq .Lmk61_memmove_one\\name\n"
" ldrh r3,[r1]\n"
" cmp r2,#2\n"
" beq .Lmk61_memmove_two\\name\n"
" ldrb r1,[r1,#2]\n"
" strb r1,[r0,#2]\n"
".Lmk61_memmove_two\\name:\n"
" strh r3,[r0]\n"
" bx lr\n"
".Lmk61_memmove_one\\name:\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
".Lmk61_memmove_noop\\name:\n"
" bx lr\n"
".Lmk61_memmove_medium\\name:\n"
" push {r4,r5,r6}\n"
" cmp r2,#16\n"
" bhi .Lmk61_memmove_wide\\name\n"
" ldr r3,[r1]\n"
" ldr r4,[r1,#4]\n"
" subs r2,#8\n"
" add r1,r2\n"
" ldr r5,[r1]\n"
" ldr r6,[r1,#4]\n"
" add r2,r0\n"
" str r3,[r0]\n"
" str r4,[r0,#4]\n"
" str r5,[r2]\n"
" str r6,[r2,#4]\n"
" pop {r4,r5,r6}\n"
" bx lr\n"
".Lmk61_memmove_wide\\name:\n"
" cmp r2,#33\n"
" bhi .Lmk61_memmove_large\\name\n"
" /* Head/tail words plus the middle byte cover 17..33 bytes. All are\n"
"  * captured before stores, including when the source overlaps by one byte. */\n"
" push {r7,r8,r9,r10}\n"
" ldrb r12,[r1,#16]\n"
" ldr r3,[r1]\n"
" ldr r4,[r1,#4]\n"
" ldr r5,[r1,#8]\n"
" ldr r6,[r1,#12]\n"
" subs r2,#16\n"
" add r1,r2\n"
" ldr r7,[r1]\n"
" ldr r8,[r1,#4]\n"
" ldr r9,[r1,#8]\n"
" ldr r10,[r1,#12]\n"
" add r2,r0\n"
" str r3,[r0]\n"
" str r4,[r0,#4]\n"
" str r5,[r0,#8]\n"
" str r6,[r0,#12]\n"
" str r7,[r2]\n"
" str r8,[r2,#4]\n"
" str r9,[r2,#8]\n"
" str r10,[r2,#12]\n"
" strb r12,[r0,#16]\n"
" pop {r7,r8,r9,r10}\n"
" pop {r4,r5,r6}\n"
" bx lr\n"
".Lmk61_memmove_large\\name:\n"
" mov r12,r0\n"
" cmp r0,r1\n"
" bhi .Lmk61_memmove_backward\\name\n"
" mk61_move_directional \\name,f\\name,0,\\unroll\n"
".Lmk61_memmove_backward\\name:\n"
" mk61_move_directional \\name,b\\name,1,\\unroll\n"
".endm\n"
"\n"
"mk61_move_move body,1\n"
".purgem mk61_move_move\n"
".purgem mk61_move_directional\n"
".purgem mk61_move_block\n"
