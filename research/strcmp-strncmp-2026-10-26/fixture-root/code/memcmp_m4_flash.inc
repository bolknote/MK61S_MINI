/* Bounded, read-only unsigned lexicographic comparison.
 * Returns the ISO C sign; unequal word results may be -1 or +1.
 * Generated from research/memcmp-2026-10-21/candidates.S by export.py. */
".syntax unified\n"
"\n"
".macro mk61_compare_word_pair tag,mk61_compare_offset,bulk=0\n"
" ldr r3,[r0,#\\mk61_compare_offset]\n"
" ldr mk61_compare_cmp_word,[r1,#\\mk61_compare_offset]\n"
" cmp r3,mk61_compare_cmp_word\n"
" .if \\bulk\n"
" bne .Lmk61_compare_bulkDiff\\tag\n"
" .else\n"
" bne .Lmk61_compare_wordDiff\\tag\n"
" .endif\n"
".endm\n"
".macro mk61_compare_byte_pair tag,mk61_compare_offset,tail=0\n"
" ldrb r3,[r0,#\\mk61_compare_offset]\n"
" ldrb r12,[r1,#\\mk61_compare_offset]\n"
" subs r3,r3,r12\n"
" .if \\tail\n"
" bne .Lmk61_compare_tailDiff\\tag\n"
" .else\n"
" bne .Lmk61_compare_byteDiff\\tag\n"
" .endif\n"
".endm\n"
".macro mk61_compare_compare name,words,low=0\n"
" .if \\low\n"
" mk61_compare_cmp_word .req r4\n"
" .else\n"
" mk61_compare_cmp_word .req r12\n"
" .endif\n"
" cbz r2,.Lmk61_compare_zero\\name\n"
" cmp r0,r1\n"
" beq .Lmk61_compare_zero\\name\n"
" mk61_compare_byte_pair \\name,0\n"
" cmp r2,#1\n"
" beq .Lmk61_compare_zero\\name\n"
" cmp r2,#4\n"
" bhs .Lmk61_compare_headWord\\name\n"
" mk61_compare_byte_pair \\name,1\n"
" cmp r2,#2\n"
" beq .Lmk61_compare_zero\\name\n"
" mk61_compare_byte_pair \\name,2\n"
".Lmk61_compare_byteDiff\\name:\n"
" mov r0,r3\n"
" bx lr\n"
".Lmk61_compare_zero\\name:\n"
" movs r0,#0\n"
" bx lr\n"
".Lmk61_compare_headWord\\name:\n"
" .if \\low\n"
" push {r4}\n"
" .endif\n"
" /* Inspect the head before any bulk dispatch or alignment arithmetic. */\n"
" mk61_compare_word_pair \\name,0\n"
" cmp r2,#8\n"
" bhs .Lmk61_compare_headEight\\name\n"
" subs r2,#4\n"
" beq .Lmk61_compare_wordZero\\name\n"
" ldr r3,[r0,r2]\n"
" ldr mk61_compare_cmp_word,[r1,r2]\n"
" cmp r3,mk61_compare_cmp_word\n"
" beq .Lmk61_compare_wordZero\\name\n"
".Lmk61_compare_wordDiff\\name:\n"
" rev r0,r3\n"
" rev r1,mk61_compare_cmp_word\n"
" cmp r0,r1\n"
" sbcs r0,r0\n"
" orr r0,r0,#1\n"
" .if \\low\n"
" pop {r4}\n"
" .endif\n"
" bx lr\n"
".Lmk61_compare_wordZero\\name:\n"
" movs r0,#0\n"
" .if \\low\n"
" pop {r4}\n"
" .endif\n"
" bx lr\n"
".Lmk61_compare_headEight\\name:\n"
" mk61_compare_word_pair \\name,4\n"
" cmp r2,#16\n"
" bhi .Lmk61_compare_middle\\name\n"
" /* Exact tail pair covers 8..16 together with the already checked head. */\n"
" subs r2,#8\n"
" beq .Lmk61_compare_wordZero\\name\n"
" ldr r3,[r0,r2]\n"
" ldr mk61_compare_cmp_word,[r1,r2]\n"
" cmp r3,mk61_compare_cmp_word\n"
" bne .Lmk61_compare_wordDiff\\name\n"
" adds r2,#4\n"
" ldr r3,[r0,r2]\n"
" ldr mk61_compare_cmp_word,[r1,r2]\n"
" cmp r3,mk61_compare_cmp_word\n"
" bne .Lmk61_compare_wordDiff\\name\n"
" b .Lmk61_compare_wordZero\\name\n"
".Lmk61_compare_middle\\name:\n"
" cmp r2,#32\n"
" bhi .Lmk61_compare_large\\name\n"
" /* Bounded short path: mk61_compare_compare complete head words and one exact tail. */\n"
" mk61_compare_word_pair \\name,8\n"
" mk61_compare_word_pair \\name,12\n"
" cmp r2,#20\n"
" bls .Lmk61_compare_middleTail\\name\n"
" mk61_compare_word_pair \\name,16\n"
" cmp r2,#24\n"
" bls .Lmk61_compare_middleTail\\name\n"
" mk61_compare_word_pair \\name,20\n"
" cmp r2,#28\n"
" bls .Lmk61_compare_middleTail\\name\n"
" mk61_compare_word_pair \\name,24\n"
".Lmk61_compare_middleTail\\name:\n"
" subs r2,#4\n"
" ldr r3,[r0,r2]\n"
" ldr mk61_compare_cmp_word,[r1,r2]\n"
" cmp r3,mk61_compare_cmp_word\n"
" bne .Lmk61_compare_wordDiff\\name\n"
" b .Lmk61_compare_wordZero\\name\n"
".Lmk61_compare_large\\name:\n"
" .if \\words>1\n"
" /* Align inside the checked head: duplicate at most three bytes, skip none. */\n"
" and r3,r0,#3\n"
" rsb r3,r3,#8\n"
" adds r0,r0,r3\n"
" adds r1,r1,r3\n"
" subs r2,r2,r3\n"
" .else\n"
" adds r0,#8\n"
" adds r1,#8\n"
" subs r2,#8\n"
" .endif\n"
".Lmk61_compare_words\\name:\n"
" .if \\words>1\n"
" cmp r2,#(4*\\words)\n"
" .if \\words>4\n"
" blo .Lmk61_compare_medium\\name\n"
" .else\n"
" blo .Lmk61_compare_word\\name\n"
" .endif\n"
" b .Lmk61_compare_bulk\\name\n"
".Lmk61_compare_bulkDiff\\name:\n"
" b .Lmk61_compare_wordDiff\\name\n"
".Lmk61_compare_bulk\\name:\n"
" .set mk61_compare_offset,0\n"
" .rept \\words\n"
" mk61_compare_word_pair \\name,mk61_compare_offset,1\n"
" .set mk61_compare_offset,mk61_compare_offset+4\n"
" .endr\n"
" adds r0,#(4*\\words)\n"
" adds r1,#(4*\\words)\n"
" subs r2,#(4*\\words)\n"
" cmp r2,#(4*\\words)\n"
" bhs .Lmk61_compare_bulk\\name\n"
" .if \\words>4\n"
".Lmk61_compare_medium\\name:\n"
" cmp r2,#16\n"
" blo .Lmk61_compare_wordCheck\\name\n"
".Lmk61_compare_16\\name:\n"
" mk61_compare_word_pair \\name,0,1\n"
" mk61_compare_word_pair \\name,4,1\n"
" mk61_compare_word_pair \\name,8,1\n"
" mk61_compare_word_pair \\name,12,1\n"
" adds r0,#16\n"
" adds r1,#16\n"
" subs r2,#16\n"
" cmp r2,#16\n"
" bhs .Lmk61_compare_16\\name\n"
".Lmk61_compare_wordCheck\\name:\n"
" .endif\n"
" cmp r2,#4\n"
" blo .Lmk61_compare_tail\\name\n"
" .else\n"
" b .Lmk61_compare_word\\name\n"
".Lmk61_compare_bulkDiff\\name:\n"
" b .Lmk61_compare_wordDiff\\name\n"
" .endif\n"
".Lmk61_compare_word\\name:\n"
" mk61_compare_word_pair \\name,0,1\n"
" adds r0,#4\n"
" adds r1,#4\n"
" subs r2,#4\n"
" cmp r2,#4\n"
" bhs .Lmk61_compare_word\\name\n"
".Lmk61_compare_tail\\name:\n"
" cmp r2,#0\n"
" beq .Lmk61_compare_wordZero\\name\n"
" mk61_compare_byte_pair \\name,0,1\n"
" cmp r2,#1\n"
" beq .Lmk61_compare_wordZero\\name\n"
" mk61_compare_byte_pair \\name,1,1\n"
" cmp r2,#2\n"
" beq .Lmk61_compare_wordZero\\name\n"
" mk61_compare_byte_pair \\name,2,1\n"
".Lmk61_compare_tailDiff\\name:\n"
" mov r0,r3\n"
" .if \\low\n"
" pop {r4}\n"
" .endif\n"
" bx lr\n"
" .unreq mk61_compare_cmp_word\n"
".endm\n"
"\n"
"mk61_compare_compare body,16\n"
".purgem mk61_compare_compare\n"
".purgem mk61_compare_word_pair\n"
".purgem mk61_compare_byte_pair\n"
