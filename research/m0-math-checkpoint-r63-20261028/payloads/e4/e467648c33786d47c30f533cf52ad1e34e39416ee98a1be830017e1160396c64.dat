cmake_minimum_required(VERSION 3.20)
set(PICO_NO_PICOTOOL 1 CACHE BOOL "Offline build" FORCE)
set(PICO_BOARD pico CACHE STRING "RP2040 Pico H" FORCE)
include(${PICO_SDK_PATH}/external/pico_sdk_import.cmake)
project(m0_r55_pow_hil C CXX ASM)
pico_sdk_init()
add_executable(m0_r55_pow_hil bench.c measure.S descriptors.c blobs.S runtime-clocks-keep-rtc.c runtime-resets-keep-rtc.c)
target_include_directories(m0_r55_pow_hil PRIVATE ${CMAKE_CURRENT_LIST_DIR})
target_compile_options(m0_r55_pow_hil PRIVATE -Os -fno-unwind-tables -fno-asynchronous-unwind-tables -fstack-usage -fno-delete-null-pointer-checks)
target_compile_definitions(m0_r55_pow_hil PRIVATE
    PICO_STACK_SIZE=4096 PICO_USE_STACK_GUARDS=1
    PICO_STDIO_ENABLE_CRLF_SUPPORT=0 PICO_NO_BI_STDIO_USB=1
    PICO_PRINTF_ALWAYS_INCLUDED=0 CFG_TUSB_DEBUG=0
)
target_link_libraries(m0_r55_pow_hil PRIVATE pico_stdlib tinyusb_device hardware_watchdog hardware_clocks)
pico_enable_stdio_usb(m0_r55_pow_hil 0)
pico_enable_stdio_uart(m0_r55_pow_hil 0)
pico_set_binary_type(m0_r55_pow_hil no_flash)
pico_set_linker_script(m0_r55_pow_hil ${CMAKE_CURRENT_LIST_DIR}/memmap.ld)
target_link_options(m0_r55_pow_hil PRIVATE -Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/m0_r55_pow_hil.map -Wl,-z,noexecstack -Wl,--wrap=panic)
pico_add_extra_outputs(m0_r55_pow_hil)
