/* ARMv7E-M: bounded head/tail copies, aligned source LDM and 64-byte blocks.
 * Ordinary LDR/STR may be unaligned; LDM is used only on aligned addresses. */
".macro mk61_memcpy_block align_source\n"
" .if \\align_source\n"
" ldmia r1!,{r3,r4,r5,r6}\n"
" str r3,[r0]\n"
" str r4,[r0,#4]\n"
" str r5,[r0,#8]\n"
" str r6,[r0,#12]\n"
" adds r0,#16\n"
" .else\n"
" ldr r3,[r1]\n"
" ldr r4,[r1,#4]\n"
" ldr r5,[r1,#8]\n"
" ldr r6,[r1,#12]\n"
" adds r1,#16\n"
" stmia r0!,{r3,r4,r5,r6}\n"
" .endif\n"
".endm\n"
".macro mk61_memcpy_m4copy name, align_source\n"
" cmp r2,#4\n"
" blo .Lmk61_memcpy_tiny\\@\n"
" cmp r2,#32\n"
" bhi .Lmk61_memcpy_large\\@\n"
" cmp r2,#8\n"
" bhs .Lmk61_memcpy_8\\@\n"
" ldr r3,[r1]\n"
" str r3,[r0]\n"
" subs r2,#4\n"
" ldr r3,[r1,r2]\n"
" str r3,[r0,r2]\n"
" bx lr\n"
".Lmk61_memcpy_8\\@:\n"
" cmp r2,#16\n"
" bhs .Lmk61_memcpy_16short\\@\n"
" ldr r3,[r1]\n"
" str r3,[r0]\n"
" ldr r3,[r1,#4]\n"
" str r3,[r0,#4]\n"
" subs r2,#8\n"
" beq .Lmk61_memcpy_ret\\@\n"
" add r1,r2\n"
" add r2,r0\n"
" ldr r3,[r1]\n"
" str r3,[r2]\n"
" ldr r3,[r1,#4]\n"
" str r3,[r2,#4]\n"
" bx lr\n"
".Lmk61_memcpy_16short\\@:\n"
" push {r4,r5}\n"
" ldr r3,[r1]\n"
" ldr r4,[r1,#4]\n"
" ldr r5,[r1,#8]\n"
" str r3,[r0]\n"
" str r4,[r0,#4]\n"
" str r5,[r0,#8]\n"
" ldr r3,[r1,#12]\n"
" str r3,[r0,#12]\n"
" subs r2,#16\n"
" beq .Lmk61_memcpy_shortPop\\@\n"
" add r1,r2\n"
" add r2,r0\n"
" ldr r3,[r1]\n"
" ldr r4,[r1,#4]\n"
" ldr r5,[r1,#8]\n"
" str r3,[r2]\n"
" str r4,[r2,#4]\n"
" str r5,[r2,#8]\n"
" ldr r3,[r1,#12]\n"
" str r3,[r2,#12]\n"
" .Lmk61_memcpy_shortPop\\@:\n"
" pop {r4,r5}\n"
" bx lr\n"
".Lmk61_memcpy_large\\@:\n"
" mov r12,r0\n"
" push {r4,r5,r6}\n"
" .if \\align_source\n"
" ands r3,r1,#3\n"
" .else\n"
" ands r3,r0,#3\n"
" .endif\n"
" beq .Lmk61_memcpy_bulk\\@\n"
" ldr r4,[r1]\n"
" str r4,[r0]\n"
" rsb r3,r3,#4\n"
" add r0,r3\n"
" add r1,r3\n"
" subs r2,r3\n"
".Lmk61_memcpy_bulk\\@:\n"
" subs r2,#64\n"
" blo .Lmk61_memcpy_fix16\\@\n"
".Lmk61_memcpy_64\\@:\n"
" .rept 4\n"
" mk61_memcpy_block \\align_source\n"
" .endr\n"
" subs r2,#64\n"
" bhs .Lmk61_memcpy_64\\@\n"
".Lmk61_memcpy_fix16\\@:\n"
" adds r2,#48\n"
" blo .Lmk61_memcpy_tail\\@\n"
".Lmk61_memcpy_16\\@:\n"
" mk61_memcpy_block \\align_source\n"
" subs r2,#16\n"
" bhs .Lmk61_memcpy_16\\@\n"
".Lmk61_memcpy_tail\\@:\n"
" adds r2,#16\n"
" pop {r4,r5,r6}\n"
" cmp r2,#8\n"
" blo .Lmk61_memcpy_four\\@\n"
" ldr r3,[r1],#4\n"
" str r3,[r0],#4\n"
" ldr r3,[r1],#4\n"
" str r3,[r0],#4\n"
" subs r2,#8\n"
".Lmk61_memcpy_four\\@:\n"
" cmp r2,#4\n"
" blo .Lmk61_memcpy_bytes\\@\n"
" ldr r3,[r1],#4\n"
" str r3,[r0],#4\n"
" subs r2,#4\n"
".Lmk61_memcpy_bytes\\@:\n"
" cbz r2,.Lmk61_memcpy_done\\@\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
" cmp r2,#1\n"
" beq .Lmk61_memcpy_done\\@\n"
" ldrb r3,[r1,#1]\n"
" strb r3,[r0,#1]\n"
" cmp r2,#2\n"
" beq .Lmk61_memcpy_done\\@\n"
" ldrb r3,[r1,#2]\n"
" strb r3,[r0,#2]\n"
".Lmk61_memcpy_done\\@:\n"
" mov r0,r12\n"
" bx lr\n"
".Lmk61_memcpy_tiny\\@:\n"
" cbz r2,.Lmk61_memcpy_ret\\@\n"
" ldrb r3,[r1]\n"
" strb r3,[r0]\n"
" cmp r2,#1\n"
" beq .Lmk61_memcpy_ret\\@\n"
" ldrb r3,[r1,#1]\n"
" strb r3,[r0,#1]\n"
" cmp r2,#2\n"
" beq .Lmk61_memcpy_ret\\@\n"
" ldrb r3,[r1,#2]\n"
" strb r3,[r0,#2]\n"
".Lmk61_memcpy_ret\\@:\n"
" bx lr\n"
".endm\n"
"mk61_memcpy_m4copy mk61_memcpy,1\n"
".purgem mk61_memcpy_m4copy\n"
".purgem mk61_memcpy_block\n"
