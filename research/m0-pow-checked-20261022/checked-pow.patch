+  printf ("Please report to core-math@inria.fr:\n");
+  printf ("Worst-case of pow found: x,y=%la,%la\n", x, y);
+  exit (1);
+
+#else
+  return -0.0;
+#endif /* ENABLE_ZIV3 */
