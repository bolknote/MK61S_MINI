" subs r2,#1\n"
" bne .Lmk61_compare_smallByte\\name\n"
".Lmk61_compare_equal\\name:\n"
" movs r3,#0\n"
".Lmk61_compare_byteDiff\\name:\n"
" movs r0,r3\n"
" pop {r4}\n"
".Lmk61_compare_return\\name:\n"
" bx lr\n"
".Lmk61_compare_zero\\name:\n"
" movs r0,#0\n"
" bx lr\n"
" .if \\words==16\n"
".Lmk61_compare_four\\name:\n"
" /* The frequent naturally aligned four-byte case needs no saved registers. */\n"
" cmp r0,r1\n"
" beq .Lmk61_compare_zero\\name\n"
" mov r12,r0\n"
" ldrb r0,[r0]\n"
" ldrb r3,[r1]\n"
" subs r0,r0,r3\n"
" bne .Lmk61_compare_return\\name\n"
" mov r0,r12\n"
" movs r3,r0\n"
" orrs r3,r1\n"
" lsls r3,r3,#30\n"
" bne .Lmk61_compare_tiny\\name\n"
" ldr r3,[r0]\n"
" ldr r0,[r1]\n"
" cmp r3,r0\n"
" bne .Lmk61_compare_fourDiff\\name\n"
" movs r0,#0\n"
" bx lr\n"
".Lmk61_compare_fourDiff\\name:\n"
" rev r1,r0\n"
" rev r0,r3\n"
" cmp r0,r1\n"
" sbcs r0,r0\n"
" movs r1,#1\n"
" orrs r0,r1\n"
" bx lr\n"
".Lmk61_compare_tiny\\name:\n"
" /* Keep 2..7-byte comparisons entirely in caller-saved registers. */\n"
" mov r0,r12\n"
" ldrb r0,[r0,#1]\n"
" ldrb r3,[r1,#1]\n"
" subs r0,r0,r3\n"
" bne .Lmk61_compare_return\\name\n"
" cmp r2,#2\n"
" beq .Lmk61_compare_return\\name\n"
" mov r0,r12\n"
" ldrb r0,[r0,#2]\n"
" ldrb r3,[r1,#2]\n"
" subs r0,r0,r3\n"
" bne .Lmk61_compare_return\\name\n"
" cmp r2,#3\n"
" beq .Lmk61_compare_return\\name\n"
" mov r0,r12\n"
" ldrb r0,[r0,#3]\n"
" ldrb r3,[r1,#3]\n"
" subs r0,r0,r3\n"
" bne .Lmk61_compare_return\\name\n"
" cmp r2,#4\n"
" beq .Lmk61_compare_return\\name\n"
" mov r0,r12\n"
" ldrb r0,[r0,#4]\n"
" ldrb r3,[r1,#4]\n"
" subs r0,r0,r3\n"
" bne .Lmk61_compare_return\\name\n"
" cmp r2,#5\n"
" beq .Lmk61_compare_return\\name\n"
" mov r0,r12\n"
" ldrb r0,[r0,#5]\n"
" ldrb r3,[r1,#5]\n"
" subs r0,r0,r3\n"
" bne .Lmk61_compare_return\\name\n"
" cmp r2,#6\n"
" beq .Lmk61_compare_return\\name\n"
" mov r0,r12\n"
" ldrb r0,[r0,#6]\n"
" ldrb r3,[r1,#6]\n"
" subs r0,r0,r3\n"
" bx lr\n"
".Lmk61_compare_mergePrefix\\name:\n"
" /* Resolve early differences before the shifted-word mk61_compare_merge setup. */\n"
" push {r4}\n"
" mk61_compare_byte_pair \\name,1\n"
" mk61_compare_byte_pair \\name,2\n"
" mk61_compare_byte_pair \\name,3\n"
" mk61_compare_byte_pair \\name,4\n"
" cmp r2,#12\n"
" bhs .Lmk61_compare_prefixContinue\\name\n"
" adds r0,#5\n"
" adds r1,#5\n"
" subs r2,#5\n"
" b .Lmk61_compare_smallRemaining\\name\n"
".Lmk61_compare_prefixContinue\\name:\n"
" adds r0,#4\n"
" adds r1,#4\n"
" subs r2,#4\n"
" b .Lmk61_compare_prepareSaved\\name\n"
" .endif\n"
".Lmk61_compare_prepare\\name:\n"
" push {r4}\n"
".Lmk61_compare_prepareSaved\\name:\n"
" lsls r3,r0,#30\n"
" beq .Lmk61_compare_aligned\\name\n"
" /* Skip the already checked first byte before aligning the left span. */\n"
" adds r0,#1\n"
" adds r1,#1\n"
" subs r2,#1\n"
" lsls r3,r0,#30\n"
" beq .Lmk61_compare_aligned\\name\n"
".Lmk61_compare_prefix\\name:\n"
" mk61_compare_byte_pair \\name,0\n"
" adds r0,#1\n"
" adds r1,#1\n"
" subs r2,#1\n"
" lsls r3,r0,#30\n"
" bne .Lmk61_compare_prefix\\name\n"
".Lmk61_compare_aligned\\name:\n"
" .if \\words>1\n"
" lsls r3,r1,#30\n"
" beq .Lmk61_compare_words\\name\n"
" movs r3,#3\n"
" ands r3,r1\n"
" cmp r3,#1\n"
" bne .Lmk61_compare_not3\\name\n"
" b .Lmk61_compare_merge\\name\\()3\n"
".Lmk61_compare_not3\\name:\n"
" cmp r3,#2\n"
" bne .Lmk61_compare_not2\\name\n"
" b .Lmk61_compare_merge\\name\\()2\n"
".Lmk61_compare_not2\\name:\n"
" b .Lmk61_compare_merge\\name\\()1\n"
" .else\n"
" b .Lmk61_compare_words\\name\n"
" .endif\n"
".Lmk61_compare_wordDiff\\name:\n"
" rev r0,r3\n"
" rev r1,r4\n"
" cmp r0,r1\n"
" sbcs r0,r0\n"
" movs r1,#1\n"
" orrs r0,r1\n"
" pop {r4}\n"
" bx lr\n"
".Lmk61_compare_words\\name:\n"
" .if \\words>1\n"
" cmp r2,#(4*\\words)\n"
" .if \\words>4\n"
" blo .Lmk61_compare_medium\\name\n"
" .else\n"
" blo .Lmk61_compare_word\\name\n"
" .endif\n"
".Lmk61_compare_bulk\\name:\n"
" .rept \\words\n"
" mk61_compare_word_pair \\name\n"
" .endr\n"
" subs r2,#(4*\\words)\n"
" cmp r2,#(4*\\words)\n"
" bhs .Lmk61_compare_bulk\\name\n"
" .if \\words>4\n"
".Lmk61_compare_medium\\name:\n"
" cmp r2,#16\n"
" blo .Lmk61_compare_wordCheck\\name\n"
".Lmk61_compare_16\\name:\n"
" .rept 4\n"
" mk61_compare_word_pair \\name\n"
" .endr\n"
" subs r2,#16\n"
" cmp r2,#16\n"
" bhs .Lmk61_compare_16\\name\n"
".Lmk61_compare_wordCheck\\name:\n"
" .endif\n"
" cmp r2,#4\n"
" blo .Lmk61_compare_tail\\name\n"
" .endif\n"
".Lmk61_compare_word\\name:\n"
" mk61_compare_word_pair \\name\n"
" subs r2,#4\n"
" cmp r2,#4\n"
" bhs .Lmk61_compare_word\\name\n"
".Lmk61_compare_tail\\name:\n"
" cmp r2,#0\n"
" beq .Lmk61_compare_wordEqual\\name\n"
".Lmk61_compare_tailByte\\name:\n"
" ldrb r3,[r0]\n"
" ldrb r4,[r1]\n"
