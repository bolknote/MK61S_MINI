# Локальные результаты сборки прошивки
/*.bin
/binary/
/.build/
/.mk61-firmware.conf
/.mkc.conf

# Локальные стенды; исходники исследований сохраняются в research/
/tmp/

# Рабочие планы VM сохраняются локально по просьбе пользователя
/plan-vm.md
/plan-vm-cache.md

# Локальное исследование команд Ms
/research/ms-rom-reachability/

# Кэши инструментов Python
__pycache__/
*.py[cod]

# Служебные файлы Finder не относятся к исходникам проекта
.DS_Store

# Spectrum games are downloaded locally, never committed.
/third_party/spectrum-games/**/*.zip
/third_party/spectrum-games/**/*.zip.tmp
/third_party/spectrum-games/runtime.json
/programs/spectrum/GAMES.img
